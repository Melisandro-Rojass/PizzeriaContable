@model PizzeriaContable.Services.BalanceGeneralViewModel
@{
    ViewData["Title"] = "Balance General";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-bank me-2 text-primary"></i>Balance General</h2>
            <p class="text-muted small mb-0">Situación Financiera Patrimonial: Activos = Pasivos + Capital</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportarBalanceGeneralCsv" asp-route-fechaCorte="@ViewBag.FechaCorte" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
            </a>
            <button class="btn btn-outline-dark" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Imprimir
            </button>
        </div>
    </div>

    <!-- Filtro de Fecha de Corte -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold">Fecha de Corte</label>
                    <input type="date" name="fechaCorte" class="form-control form-control-sm" value="@ViewBag.FechaCorte" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-filter me-1"></i> Generar a la Fecha</button>
                    <a asp-action="BalanceGeneral" class="btn btn-outline-secondary btn-sm">Hoy</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Indicador de Cuadre Contable -->
    <div class="alert @(Model.EstaCuadrado ? "alert-success" : "alert-danger") border shadow-sm mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="bi @(Model.EstaCuadrado ? "bi-check-circle-fill" : "bi-exclamation-octagon-fill") fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-0">
                        @(Model.EstaCuadrado ? "Balance General Perfectamente Equilibrado" : "Balance General con Diferencia")
                    </h5>
                    <p class="mb-0 small">
                        Activos (C$ @Model.TotalActivos.ToString("N2")) = Pasivos (C$ @Model.TotalPasivos.ToString("N2")) + Patrimonio (C$ @((Model.TotalPatrimonio + Model.UtilidadPeriodo).ToString("N2")))
                    </p>
                </div>
            </div>
            <span class="badge @(Model.EstaCuadrado ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                @(Model.EstaCuadrado ? "Ecuación Cuadrada" : "Descuadre Detectado")
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: ACTIVOS -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title fw-bold mb-0"><i class="bi bi-wallet2 me-2"></i>ACTIVOS</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Cuenta</th>
                                <th class="text-end">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Activos.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted">No hay activos con saldo</td>
                                </tr>
                            }
                            @foreach (var a in Model.Activos)
                            {
                                <tr>
                                    <td class="font-monospace small">@a.Codigo</td>
                                    <td>@a.Nombre</td>
                                    <td class="text-end fw-bold">C$ @a.Saldo.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-primary fw-bold fs-6">
                            <tr>
                                <td colspan="2">TOTAL ACTIVOS:</td>
                                <td class="text-end">C$ @Model.TotalActivos.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: PASIVOS Y PATRIMONIO -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="card-title fw-bold mb-0"><i class="bi bi-receipt me-2"></i>PASIVOS (Obligaciones)</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Cuenta</th>
                                <th class="text-end">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Pasivos.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted">No hay pasivos con saldo pendiente</td>
                                </tr>
                            }
                            @foreach (var p in Model.Pasivos)
                            {
                                <tr>
                                    <td class="font-monospace small">@p.Codigo</td>
                                    <td>@p.Nombre</td>
                                    <td class="text-end fw-bold">C$ @p.Saldo.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary fw-bold fs-6">
                            <tr>
                                <td colspan="2">TOTAL PASIVOS:</td>
                                <td class="text-end">C$ @Model.TotalPasivos.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="card-title fw-bold mb-0"><i class="bi bi-shield-check me-2"></i>PATRIMONIO NETO</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Cuenta</th>
                                <th class="text-end">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Patrimonio)
                            {
                                <tr>
                                    <td class="font-monospace small">@c.Codigo</td>
                                    <td>@c.Nombre</td>
                                    <td class="text-end fw-bold">C$ @c.Saldo.ToString("N2")</td>
                                </tr>
                            }
                            <tr>
                                <td class="font-monospace small">-</td>
                                <td>Utilidad del Ejercicio Actual</td>
                                <td class="text-end fw-bold @(Model.UtilidadPeriodo >= 0 ? "text-success" : "text-danger")">
                                    C$ @Model.UtilidadPeriodo.ToString("N2")
                                </td>
                            </tr>
                        </tbody>
                        <tfoot class="table-success fw-bold fs-6">
                            <tr>
                                <td colspan="2">TOTAL PATRIMONIO:</td>
                                <td class="text-end">C$ @((Model.TotalPatrimonio + Model.UtilidadPeriodo).ToString("N2"))</td>
                            </tr>
                            <tr class="table-dark fs-5">
                                <td colspan="2">TOTAL PASIVO + PATRIMONIO:</td>
                                <td class="text-end">C$ @((Model.TotalPasivos + Model.TotalPatrimonio + Model.UtilidadPeriodo).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
