@model PizzeriaContable.Services.BalanceGeneralViewModel
@{
    ViewData["Title"] = "Balance General";
}

<div class="container-xl mx-auto px-0">
    <!-- Encabezado de Página Centrado y Equilibrado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom" style="border-color: var(--sc-border-warm) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark fuente-marca px-2 py-1">Estado Patrimonial</span>
                <span class="text-muted small">&bull; Moneda: Córdobas (NIO C$)</span>
            </div>
            <h1 class="h3 fw-bold text-dark fuente-marca mb-0">
                <i class="bi bi-bank text-warning me-2"></i>Balance General
            </h1>
            <p class="text-muted small mb-0">
                Situación Financiera Patrimonial: Activos = Pasivos + Capital
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="ExportarBalanceGeneralCsv" asp-route-fechaCorte="@ViewBag.FechaCorte" class="btn btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet"></i> <span>Exportar CSV</span>
            </a>
            <button type="button" class="btn btn-outline-dark d-inline-flex align-items-center gap-1 shadow-sm" onclick="window.print()">
                <i class="bi bi-printer"></i> <span>Imprimir</span>
            </button>
        </div>
    </div>

    <!-- Filtro de Fecha de Corte -->
    <div class="card mb-4 border shadow-sm" style="border-color: var(--sc-border-warm) !important;">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-sm-8 col-md-5">
                    <label class="form-label small fw-bold text-dark">
                        <i class="bi bi-calendar-event me-1 text-warning"></i>Fecha de Corte
                    </label>
                    <input type="date" name="fechaCorte" class="form-control" value="@ViewBag.FechaCorte" />
                </div>
                <div class="col-sm-4 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-saycheese-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-filter"></i> <span>Generar a la Fecha</span>
                    </button>
                    <a asp-action="BalanceGeneral" class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center">
                        <span>Hoy</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Indicador de Cuadre Contable -->
    <div class="alert @(Model.EstaCuadrado ? "alert-success" : "alert-danger") border shadow-sm mb-4 rounded-3 p-3" style="border-left: 5px solid @(Model.EstaCuadrado ? "var(--sc-green)" : "var(--sc-red)") !important; background-color: @(Model.EstaCuadrado ? "var(--sc-green-bg)" : "var(--sc-red-bg)");">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <i class="bi @(Model.EstaCuadrado ? "bi-check-circle-fill text-success" : "bi-exclamation-octagon-fill text-danger") fs-2 me-3 flex-shrink-0"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-1 text-dark fuente-marca">
                        @(Model.EstaCuadrado ? "Balance General Equilibrado" : "Balance General con Diferencia")
                    </h5>
                    <p class="mb-0 small text-dark fuente-numerica">
                        Activos (C$ @Model.TotalActivos.ToString("N2")) = Pasivos (C$ @Model.TotalPasivos.ToString("N2")) + Patrimonio (C$ @((Model.TotalPatrimonio + Model.UtilidadPeriodo).ToString("N2")))
                    </p>
                </div>
            </div>
            <span class="badge @(Model.EstaCuadrado ? "bg-success" : "bg-danger") fs-6 px-3 py-2 rounded-pill flex-shrink-0">
                <i class="bi @(Model.EstaCuadrado ? "bi-shield-check" : "bi-exclamation-triangle") me-1"></i>
                @(Model.EstaCuadrado ? "Balance Cuadrado" : "Descuadre Detectado")
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: ACTIVOS -->
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm overflow-hidden" style="border-color: var(--sc-border-warm) !important;">
                <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #3A1009 0%, #1A0704 100%); border-bottom: 3px solid var(--sc-yellow);">
                    <h5 class="card-title fw-bold mb-0 fuente-marca text-white"><i class="bi bi-wallet2 text-warning me-2"></i>ACTIVOS</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: var(--sc-gray-warm); border-bottom: 2px solid var(--sc-border-warm);">
                            <tr>
                                <th style="width: 100px;">Código</th>
                                <th>Cuenta</th>
                                <th class="text-end" style="width: 140px;">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Activos.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No hay activos con saldo</td>
                                </tr>
                            }
                            @foreach (var a in Model.Activos)
                            {
                                <tr>
                                    <td class="font-monospace small fw-bold text-dark">@a.Codigo</td>
                                    <td class="text-dark">@a.Nombre</td>
                                    <td class="text-end fw-bold fuente-numerica text-primary">C$ @a.Saldo.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold fs-6" style="background-color: #FEF3E8; border-top: 2px solid var(--sc-orange);">
                            <tr>
                                <td colspan="2" class="text-dark fuente-marca">TOTAL ACTIVOS:</td>
                                <td class="text-end fuente-numerica text-primary">C$ @Model.TotalActivos.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: PASIVOS Y PATRIMONIO -->
        <div class="col-lg-6">
            <div class="card mb-4 shadow-sm overflow-hidden" style="border-color: var(--sc-border-warm) !important;">
                <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #2E100B 0%, #170704 100%); border-bottom: 3px solid var(--sc-orange);">
                    <h5 class="card-title fw-bold mb-0 fuente-marca text-white"><i class="bi bi-receipt text-warning me-2"></i>PASIVOS (Obligaciones)</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: var(--sc-gray-warm); border-bottom: 2px solid var(--sc-border-warm);">
                            <tr>
                                <th style="width: 100px;">Código</th>
                                <th>Cuenta</th>
                                <th class="text-end" style="width: 140px;">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Pasivos.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No hay pasivos con saldo pendiente</td>
                                </tr>
                            }
                            @foreach (var p in Model.Pasivos)
                            {
                                <tr>
                                    <td class="font-monospace small fw-bold text-dark">@p.Codigo</td>
                                    <td class="text-dark">@p.Nombre</td>
                                    <td class="text-end fw-bold fuente-numerica text-danger">C$ @p.Saldo.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold fs-6" style="background-color: var(--sc-gray-warm); border-top: 2px solid var(--sc-border-warm);">
                            <tr>
                                <td colspan="2" class="text-dark fuente-marca">TOTAL PASIVOS:</td>
                                <td class="text-end fuente-numerica text-danger">C$ @Model.TotalPasivos.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="card shadow-sm overflow-hidden" style="border-color: var(--sc-border-warm) !important;">
                <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #1A4D2E 0%, #0F2E1B 100%); border-bottom: 3px solid #2ECC71;">
                    <h5 class="card-title fw-bold mb-0 fuente-marca text-white"><i class="bi bi-shield-check text-warning me-2"></i>PATRIMONIO NETO</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: var(--sc-gray-warm); border-bottom: 2px solid var(--sc-border-warm);">
                            <tr>
                                <th style="width: 100px;">Código</th>
                                <th>Cuenta</th>
                                <th class="text-end" style="width: 140px;">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Patrimonio)
                            {
                                <tr>
                                    <td class="font-monospace small fw-bold text-dark">@c.Codigo</td>
                                    <td class="text-dark">@c.Nombre</td>
                                    <td class="text-end fw-bold fuente-numerica text-success">C$ @c.Saldo.ToString("N2")</td>
                                </tr>
                            }
                            <tr>
                                <td class="font-monospace small text-muted">-</td>
                                <td class="text-dark">Utilidad del Ejercicio Actual</td>
                                <td class="text-end fw-bold fuente-numerica @(Model.UtilidadPeriodo >= 0 ? "text-success" : "text-danger")">
                                    C$ @Model.UtilidadPeriodo.ToString("N2")
                                </td>
                            </tr>
                        </tbody>
                        <tfoot class="fw-bold fs-6" style="background-color: #E8F5E9; border-top: 2px solid #2ECC71;">
                            <tr>
                                <td colspan="2" class="text-dark fuente-marca">TOTAL PATRIMONIO:</td>
                                <td class="text-end fuente-numerica text-success">C$ @((Model.TotalPatrimonio + Model.UtilidadPeriodo).ToString("N2"))</td>
                            </tr>
                            <tr class="fs-5 text-white" style="background: linear-gradient(135deg, #260B08 0%, #150503 100%); border-top: 3px solid var(--sc-yellow);">
                                <td colspan="2" class="fuente-marca text-warning">TOTAL PASIVO + PATRIMONIO:</td>
                                <td class="text-end fuente-numerica text-warning">C$ @((Model.TotalPasivos + Model.TotalPatrimonio + Model.UtilidadPeriodo).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
