@model IEnumerable<PizzeriaContable.Services.BalanceComprobacionItem>
@{
    ViewData["Title"] = "Balance de Comprobación";
    decimal totalDebe = ViewBag.TotalDebe != null ? (decimal)ViewBag.TotalDebe : 0m;
    decimal totalHaber = ViewBag.TotalHaber != null ? (decimal)ViewBag.TotalHaber : 0m;
    decimal totalSaldoDeudor = ViewBag.TotalSaldoDeudor != null ? (decimal)ViewBag.TotalSaldoDeudor : 0m;
    decimal totalSaldoAcreedor = ViewBag.TotalSaldoAcreedor != null ? (decimal)ViewBag.TotalSaldoAcreedor : 0m;

    bool movimientosCuadrados = Math.Abs(totalDebe - totalHaber) < 0.01m;
    bool saldosCuadrados = Math.Abs(totalSaldoDeudor - totalSaldoAcreedor) < 0.01m;
}

<div class="container-xl mx-auto px-0">
    <!-- Encabezado Centrado y Equilibrado con Acciones -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom" style="border-color: var(--sc-border-warm) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark fuente-marca px-2 py-1">Contabilidad General</span>
                <span class="text-muted small">&bull; Moneda: Córdobas (NIO C$)</span>
            </div>
            <h1 class="h3 fw-bold text-dark fuente-marca mb-0">
                <i class="bi bi-clipboard-data text-warning me-2"></i>Balance de Comprobación
            </h1>
            <p class="text-muted small mb-0">
                Verificación de sumas de movimientos y equilibrio de saldos deudores y acreedores del catálogo.
            </p>
        </div>
        
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="ExportarBalanceComprobacionCsv" asp-route-desde="@ViewBag.Desde" asp-route-hasta="@ViewBag.Hasta" class="btn btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet"></i> <span>Exportar CSV</span>
            </a>
            <button type="button" class="btn btn-outline-dark d-inline-flex align-items-center gap-1 shadow-sm" onclick="window.print()">
                <i class="bi bi-printer"></i> <span>Imprimir</span>
            </button>
        </div>
    </div>

    <!-- Filtros de Fecha Equilibrados -->
    <div class="card mb-4 border shadow-sm" style="border-color: var(--sc-border-warm) !important;">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-sm-6 col-md-4">
                    <label class="form-label small fw-bold text-dark">
                        <i class="bi bi-calendar-event me-1 text-warning"></i>Fecha Desde
                    </label>
                    <input type="date" name="desde" class="form-control" value="@ViewBag.Desde" />
                </div>
                <div class="col-sm-6 col-md-4">
                    <label class="form-label small fw-bold text-dark">
                        <i class="bi bi-calendar-event me-1 text-warning"></i>Fecha Hasta
                    </label>
                    <input type="date" name="hasta" class="form-control" value="@ViewBag.Hasta" />
                </div>
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-saycheese-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-filter"></i> <span>Consultar</span>
                    </button>
                    <a asp-action="BalanceComprobacion" class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center">
                        <span>Año Completo</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Indicadores de Cuadre Contable (50% / 50% Equilibrados) -->
    <div class="row g-3 mb-4">
        <!-- Tarjeta: Sumas de Movimientos -->
        <div class="col-md-6">
            <div class="card h-100 p-3 shadow-sm" style="border-left: 5px solid @(movimientosCuadrados ? "var(--sc-green)" : "var(--sc-red)") !important; border-color: var(--sc-border-warm);">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block">Sumas de Movimientos</span>
                        <span class="small text-secondary">Principio de Partida Doble (Debe == Haber)</span>
                    </div>
                    <span class="badge @(movimientosCuadrados ? "bg-success" : "bg-danger") px-3 py-1.5 rounded-pill fw-bold">
                        <i class="bi @(movimientosCuadrados ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-1"></i>
                        @(movimientosCuadrados ? "Sumas Iguales" : "Descuadre")
                    </span>
                </div>
                <div class="row g-2 pt-2 border-top text-center mt-auto" style="border-color: var(--sc-border-subtle) !important;">
                    <div class="col-6">
                        <span class="text-muted small d-block">Total Debe</span>
                        <span class="h5 mb-0 fw-bold text-dark fuente-numerica">C$ @totalDebe.ToString("N2")</span>
                    </div>
                    <div class="col-6 border-start" style="border-color: var(--sc-border-subtle) !important;">
                        <span class="text-muted small d-block">Total Haber</span>
                        <span class="h5 mb-0 fw-bold text-dark fuente-numerica">C$ @totalHaber.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta: Saldos Finales -->
        <div class="col-md-6">
            <div class="card h-100 p-3 shadow-sm" style="border-left: 5px solid @(saldosCuadrados ? "var(--sc-green)" : "var(--sc-red)") !important; border-color: var(--sc-border-warm);">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block">Saldos Finales de Cuentas</span>
                        <span class="small text-secondary">Suma Saldo Deudor == Suma Saldo Acreedor</span>
                    </div>
                    <span class="badge @(saldosCuadrados ? "bg-success" : "bg-danger") px-3 py-1.5 rounded-pill fw-bold">
                        <i class="bi @(saldosCuadrados ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-1"></i>
                        @(saldosCuadrados ? "Saldos Iguales" : "Descuadre")
                    </span>
                </div>
                <div class="row g-2 pt-2 border-top text-center mt-auto" style="border-color: var(--sc-border-subtle) !important;">
                    <div class="col-6">
                        <span class="text-muted small d-block">Saldo Deudor</span>
                        <span class="h5 mb-0 fw-bold text-primary fuente-numerica">C$ @totalSaldoDeudor.ToString("N2")</span>
                    </div>
                    <div class="col-6 border-start" style="border-color: var(--sc-border-subtle) !important;">
                        <span class="text-muted small d-block">Saldo Acreedor</span>
                        <span class="h5 mb-0 fw-bold text-success fuente-numerica">C$ @totalSaldoAcreedor.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Balance de Comprobación Centrada y Alineada -->
    <div class="card shadow-sm overflow-hidden" style="border-color: var(--sc-border-warm) !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background: linear-gradient(135deg, #3A1009 0%, #200704 100%); color: #FFFFFF; border-bottom: 3px solid var(--sc-yellow);">
                    <tr>
                        <th rowspan="2" class="align-middle text-white text-uppercase" style="width: 100px;">Código</th>
                        <th rowspan="2" class="align-middle text-white text-uppercase">Cuenta Contable</th>
                        <th rowspan="2" class="align-middle text-center text-white text-uppercase" style="width: 110px;">Tipo</th>
                        <th colspan="2" class="text-center text-white text-uppercase border-start border-end" style="border-color: rgba(255,255,255,0.15) !important;">Movimientos</th>
                        <th colspan="2" class="text-center text-white text-uppercase">Saldos</th>
                    </tr>
                    <tr style="background: rgba(0, 0, 0, 0.25); color: #FFE6D5;">
                        <th class="text-end border-start fuente-numerica" style="width: 140px; border-color: rgba(255,255,255,0.15) !important;">Debe (C$)</th>
                        <th class="text-end border-end fuente-numerica" style="width: 140px; border-color: rgba(255,255,255,0.15) !important;">Haber (C$)</th>
                        <th class="text-end fuente-numerica" style="width: 140px;">Deudor (C$)</th>
                        <th class="text-end fuente-numerica" style="width: 140px;">Acreedor (C$)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-warning"></i>
                                <span class="fw-semibold">No se encontraron movimientos contables en este período.</span>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-monospace small fw-bold text-dark">@item.Codigo</td>
                            <td class="fw-semibold text-dark">@item.Nombre</td>
                            <td class="text-center small">
                                <span class="badge rounded-pill bg-light text-dark border px-2 py-1" style="border-color: var(--sc-border-warm) !important;">
                                    @item.TipoCuenta
                                </span>
                            </td>
                            <td class="text-end border-start fuente-numerica text-secondary" style="border-color: var(--sc-border-subtle) !important;">
                                @(item.TotalDebe > 0 ? item.TotalDebe.ToString("N2") : "-")
                            </td>
                            <td class="text-end border-end fuente-numerica text-secondary" style="border-color: var(--sc-border-subtle) !important;">
                                @(item.TotalHaber > 0 ? item.TotalHaber.ToString("N2") : "-")
                            </td>
                            <td class="text-end fw-bold text-primary fuente-numerica">
                                @(item.SaldoDeudor > 0 ? item.SaldoDeudor.ToString("N2") : "-")
                            </td>
                            <td class="text-end fw-bold text-success fuente-numerica">
                                @(item.SaldoAcreedor > 0 ? item.SaldoAcreedor.ToString("N2") : "-")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot style="background: linear-gradient(135deg, #260B08 0%, #150503 100%); color: #FFFFFF; font-weight: 700; border-top: 3px solid var(--sc-yellow);">
                    <tr>
                        <td colspan="3" class="text-end text-uppercase pe-3 fuente-marca text-warning">SUMAS TOTALES:</td>
                        <td class="text-end border-start fuente-numerica" style="border-color: rgba(255,255,255,0.15) !important;">
                            C$ @totalDebe.ToString("N2")
                        </td>
                        <td class="text-end border-end fuente-numerica" style="border-color: rgba(255,255,255,0.15) !important;">
                            C$ @totalHaber.ToString("N2")
                        </td>
                        <td class="text-end fuente-numerica text-info">
                            C$ @totalSaldoDeudor.ToString("N2")
                        </td>
                        <td class="text-end fuente-numerica text-warning">
                            C$ @totalSaldoAcreedor.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
