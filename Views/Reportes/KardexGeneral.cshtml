@model IEnumerable<PizzeriaContable.Models.MovimientoInventario>
@{
    ViewData["Title"] = "Kardex General de Inventario";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-boxes me-2 text-primary"></i>Kardex General de Inventario</h2>
            <p class="text-muted small mb-0">Trazabilidad física de entradas, salidas por ventas, mermas y ajustes</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Imprimir
            </button>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Fecha Desde</label>
                    <input type="date" name="desde" class="form-control form-control-sm" value="@ViewBag.Desde" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Fecha Hasta</label>
                    <input type="date" name="hasta" class="form-control form-control-sm" value="@ViewBag.Hasta" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-filter me-1"></i> Consultar</button>
                    <a asp-action="KardexGeneral" class="btn btn-outline-secondary btn-sm">Mes Actual</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla Kardex -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Ingrediente</th>
                        <th>Tipo Movimiento</th>
                        <th>Referencia / Doc</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Costo Unit.</th>
                        <th class="text-end">Total Movimiento</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No hay movimientos de inventario registrados en el período seleccionado.
                            </td>
                        </tr>
                    }
                    @foreach (var m in Model)
                    {
                        string badgeClass = m.TipoMovimiento switch
                        {
                            "EntradaCompra" => "bg-success",
                            "InventarioInicial" => "bg-info text-dark",
                            "SalidaVenta" => "bg-primary",
                            "Merma" => "bg-danger",
                            "AjustePositivo" => "bg-warning text-dark",
                            "AjusteNegativo" => "bg-warning text-dark",
                            "ReversionAnulacion" => "bg-secondary",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="small">@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold">@m.Ingrediente?.Nombre</td>
                            <td><span class="badge @badgeClass">@m.TipoMovimiento</span></td>
                            <td class="small text-muted">@(m.Referencia ?? "-")</td>
                            <td class="text-end fw-bold @(m.Cantidad < 0 ? "text-danger" : "text-success")">
                                @m.Cantidad.ToString("N2") @m.Ingrediente?.UnidadMedida
                            </td>
                            <td class="text-end">C$ @m.CostoUnitario.ToString("N2")</td>
                            <td class="text-end fw-bold">C$ @m.Total.ToString("N2")</td>
                            <td class="small text-muted">@(m.Observaciones ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
