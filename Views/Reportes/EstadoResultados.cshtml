@model PizzeriaContable.Services.EstadoResultadosViewModel
@{
    ViewData["Title"] = "Estado de Resultados";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Estado de Resultados</h2>
            <p class="text-muted small mb-0">Rendimiento económico: Ventas, Costos de Materia Prima y Gastos Operativos</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportarEstadoResultadosCsv" asp-route-desde="@ViewBag.Desde" asp-route-hasta="@ViewBag.Hasta" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
            </a>
            <button class="btn btn-outline-dark" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Imprimir
            </button>
        </div>
    </div>

    <!-- Filtros de Fecha -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Fecha Desde</label>
                    <input type="date" name="desde" class="form-control form-control-sm" value="@ViewBag.Desde" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Fecha Hasta</label>
                    <input type="date" name="hasta" class="form-control form-control-sm" value="@ViewBag.Hasta" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-filter me-1"></i> Consultar Período</button>
                    <a asp-action="EstadoResultados" class="btn btn-outline-secondary btn-sm">Mes Actual</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tarjetas de Resumen Financiero -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white p-3">
                <span class="small text-white-50">Ventas Netas Totales</span>
                <h3 class="fw-bold mb-0">C$ @Model.TotalIngresos.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white p-3">
                <span class="small text-white-50">Costo de Materia Prima</span>
                <h3 class="fw-bold mb-0">C$ @Model.TotalCostosVentas.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark p-3">
                <span class="small text-muted fw-bold">Gastos Operativos (Fijos/Var)</span>
                <h3 class="fw-bold mb-0">C$ @Model.TotalGastosOperativos.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm @(Model.UtilidadOperativa >= 0 ? "bg-success" : "bg-danger") text-white p-3">
                <span class="small text-white-50">Utilidad Neta del Ejercicio</span>
                <h3 class="fw-bold mb-0">C$ @Model.UtilidadOperativa.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <!-- Estructura Detallada del Estado Financiero -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 text-center border-bottom">
            <h4 class="fw-bold mb-1">PIZZERÍA CONTABLE</h4>
            <h6 class="text-muted mb-0">ESTADO DE RESULTADOS INTEGRAL (En Córdobas C$)</h6>
            <small class="text-secondary">Del @Model.FechaDesde.ToString("dd/MM/yyyy") al @Model.FechaHasta.ToString("dd/MM/yyyy")</small>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <tbody>
                    <!-- INGRESOS -->
                    <tr class="table-light fw-bold fs-6">
                        <td>1. INGRESOS OPERACIONALES</td>
                        <td class="text-end text-success">C$ @Model.TotalIngresos.ToString("N2")</td>
                    </tr>
                    @foreach (var ing in Model.DetalleIngresos)
                    {
                        <tr>
                            <td class="ps-4 text-muted"><i class="bi bi-chevron-right me-1"></i>@ing.Concepto</td>
                            <td class="text-end">C$ @ing.Monto.ToString("N2")</td>
                        </tr>
                    }

                    <!-- COSTO DE VENTAS -->
                    <tr class="table-light fw-bold fs-6">
                        <td>2. MENOS: COSTO DE VENTAS (Materia Prima Consumida)</td>
                        <td class="text-end text-danger">-C$ @Model.TotalCostosVentas.ToString("N2")</td>
                    </tr>

                    <!-- MARGEN BRUTO -->
                    <tr class="table-secondary fw-bold fs-6">
                        <td>3. UTILIDAD BRUTA EN VENTAS (MARGEN BRUTO)</td>
                        <td class="text-end @(Model.MargenBruto >= 0 ? "text-success" : "text-danger")">
                            C$ @Model.MargenBruto.ToString("N2")
                            @if (Model.TotalIngresos > 0)
                            {
                                <span class="badge bg-light text-dark ms-2">@((Model.MargenBruto / Model.TotalIngresos * 100).ToString("N1"))% margen</span>
                            }
                        </td>
                    </tr>

                    <!-- GASTOS OPERATIVOS -->
                    <tr class="table-light fw-bold fs-6">
                        <td>4. MENOS: GASTOS OPERATIVOS Y ADMINISTRATIVOS</td>
                        <td class="text-end text-danger">-C$ @Model.TotalGastosOperativos.ToString("N2")</td>
                    </tr>
                    @foreach (var gas in Model.DetalleGastos)
                    {
                        <tr>
                            <td class="ps-4 text-muted"><i class="bi bi-chevron-right me-1"></i>@gas.Concepto</td>
                            <td class="text-end">C$ @gas.Monto.ToString("N2")</td>
                        </tr>
                    }

                    <!-- UTILIDAD NETA -->
                    <tr class="table-dark fw-bold fs-5">
                        <td>5. UTILIDAD OPERATIVA NETA DEL EJERCICIO</td>
                        <td class="text-end @(Model.UtilidadOperativa >= 0 ? "text-success" : "text-danger")">
                            C$ @Model.UtilidadOperativa.ToString("N2")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
