@model PizzeriaContable.Services.EstadoResultadosViewModel
@{
    ViewData["Title"] = "Estado de Resultados";
}

<div class="container-xl mx-auto px-0">
    <!-- Encabezado de Página Centrado y Equilibrado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom" style="border-color: var(--sc-border-warm) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark fuente-marca px-2 py-1">Informe Financiero</span>
                <span class="text-muted small">&bull; Moneda: Córdobas (NIO C$)</span>
            </div>
            <h1 class="h3 fw-bold text-dark fuente-marca mb-0">
                <i class="bi bi-graph-up-arrow text-warning me-2"></i>Estado de Resultados
            </h1>
            <p class="text-muted small mb-0">
                Rendimiento económico: Ventas Netas, Utilidad del Ejercicio, Costo de Materia Prima y Gastos Operativos.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="ExportarEstadoResultadosCsv" asp-route-desde="@ViewBag.Desde" asp-route-hasta="@ViewBag.Hasta" class="btn btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet"></i> <span>Exportar CSV</span>
            </a>
            <button type="button" class="btn btn-outline-dark d-inline-flex align-items-center gap-1 shadow-sm" onclick="window.print()">
                <i class="bi bi-printer"></i> <span>Imprimir</span>
            </button>
        </div>
    </div>

    @if (Model.IngresosImportados > 0 || Model.GastosImportados > 0)
    {
        <div class="alert alert-info small" role="note">
            Se incluyen C$ @Model.IngresosImportados.ToString("N2") como base neta de ventas y C$ @Model.GastosImportados.ToString("N2") en gastos desde resúmenes diarios importados. Para Q3 se trata el 15% como IVA incluido en el total cobrado y separado en IVA por pagar al contabilizar; son resúmenes, no tickets individuales, y el CSV no separa tarjeta de transferencia.
        </div>
    }

    <!-- Filtros de Fecha -->
    <div class="card mb-4 border shadow-sm" style="border-color: var(--sc-border-warm) !important;">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-sm-6 col-md-4">
                    <label class="form-label small fw-bold text-dark">
                        <i class="bi bi-calendar-event me-1 text-warning"></i>Fecha Desde
                    </label>
                    <input type="date" name="desde" class="form-control" value="@ViewBag.Desde" />
                </div>
                <div class="col-sm-6 col-md-4">
                    <label class="form-label small fw-bold text-dark">
                        <i class="bi bi-calendar-event me-1 text-warning"></i>Fecha Hasta
                    </label>
                    <input type="date" name="hasta" class="form-control" value="@ViewBag.Hasta" />
                </div>
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-saycheese-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-filter"></i> <span>Consultar Período</span>
                    </button>
                    <a asp-action="EstadoResultados" class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center">
                        <span>Mes Actual</span>
                    </a>
                    <a asp-action="EstadoResultados" asp-route-desde="2026-07-01" asp-route-hasta="2026-09-30" class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center">
                        <span>Q3 2026</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- CUATRO CUADROS INFORMATIVOS EN ORDEN ESTRICTO:
         1. Ventas netas totales
         2. Utilidad neta del ejercicio
         3. Costo de materia prima
         4. Gastos
         Dimensiones, estructura interna y márgenes uniformes -->
    <div class="row g-3 mb-4">
        <!-- 1. Ventas netas totales -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="tarjeta-estadistica est-primario h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-bold text-uppercase">1. Ventas Netas Totales</span>
                        <span class="badge bg-sc-orange-subtle text-dark border px-2 py-0.5 rounded-pill small">Ingresos</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 my-2">
                        <div class="icono-estadistica bg-sc-orange-subtle">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                        <div>
                            <span class="h4 mb-0 fw-bold text-dark fuente-numerica d-block">
                                C$ @Model.TotalIngresos.ToString("N2")
                            </span>
                            <small class="text-muted">Facturación total</small>
                        </div>
                    </div>
                </div>
                <div class="pt-2 border-top text-muted small mt-2" style="border-color: var(--sc-border-subtle) !important;">
                    <i class="bi bi-check2-circle text-success me-1"></i>Ventas netas de pizzas y bebidas
                </div>
            </div>
        </div>

        <!-- 2. Utilidad neta del ejercicio -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="tarjeta-estadistica @(Model.UtilidadOperativa >= 0 ? "est-exito" : "est-peligro") h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-bold text-uppercase">2. Utilidad Neta</span>
                        <span class="badge @(Model.UtilidadOperativa >= 0 ? "bg-success" : "bg-danger") px-2 py-0.5 rounded-pill small">
                            @(Model.UtilidadOperativa >= 0 ? "Ganancia" : "Déficit")
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-3 my-2">
                        <div class="icono-estadistica @(Model.UtilidadOperativa >= 0 ? "bg-sc-green-subtle" : "bg-sc-brick-subtle")">
                            <i class="bi @(Model.UtilidadOperativa >= 0 ? "bi-graph-up-arrow" : "bi-graph-down-arrow")"></i>
                        </div>
                        <div>
                            <span class="h4 mb-0 fw-bold @(Model.UtilidadOperativa >= 0 ? "text-success" : "text-danger") fuente-numerica d-block">
                                C$ @Model.UtilidadOperativa.ToString("N2")
                            </span>
                            <small class="text-muted">Resultado del ejercicio</small>
                        </div>
                    </div>
                </div>
                <div class="pt-2 border-top text-muted small mt-2" style="border-color: var(--sc-border-subtle) !important;">
                    <i class="bi bi-calculator text-warning me-1"></i>Ventas - Materia Prima - Gastos
                </div>
            </div>
        </div>

        <!-- 3. Costo de materia prima -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="tarjeta-estadistica est-peligro h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-bold text-uppercase">3. Costo Materia Prima</span>
                        <span class="badge bg-sc-brick-subtle text-danger border px-2 py-0.5 rounded-pill small">Insumos</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 my-2">
                        <div class="icono-estadistica bg-sc-brick-subtle">
                            <i class="bi bi-boxes"></i>
                        </div>
                        <div>
                            <span class="h4 mb-0 fw-bold text-dark fuente-numerica d-block">
                                C$ @Model.TotalCostosVentas.ToString("N2")
                            </span>
                            <small class="text-muted">Costo de ventas</small>
                        </div>
                    </div>
                </div>
                <div class="pt-2 border-top text-muted small mt-2" style="border-color: var(--sc-border-subtle) !important;">
                    <i class="bi bi-pie-chart text-danger me-1"></i>Deducción de recetas por stock
                </div>
            </div>
        </div>

        <!-- 4. Gastos -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="tarjeta-estadistica est-advertencia h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-bold text-uppercase">4. Gastos Operativos</span>
                        <span class="badge bg-sc-yellow-subtle text-dark border px-2 py-0.5 rounded-pill small">Operación</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 my-2">
                        <div class="icono-estadistica bg-sc-yellow-subtle">
                            <i class="bi bi-lightning-charge"></i>
                        </div>
                        <div>
                            <span class="h4 mb-0 fw-bold text-dark fuente-numerica d-block">
                                C$ @Model.TotalGastosOperativos.ToString("N2")
                            </span>
                            <small class="text-muted">Fijos y variables</small>
                        </div>
                    </div>
                </div>
                <div class="pt-2 border-top text-muted small mt-2" style="border-color: var(--sc-border-subtle) !important;">
                    <i class="bi bi-cash-stack text-warning me-1"></i>Servicios, local y mantenimiento
                </div>
            </div>
        </div>
    </div>

    <!-- Estructura Detallada del Estado Financiero -->
    <div class="card shadow-sm overflow-hidden" style="border-color: var(--sc-border-warm) !important;">
        <div class="card-header py-3 text-center border-bottom text-white" style="background: linear-gradient(135deg, #3A1009 0%, #200704 100%); border-bottom: 3px solid var(--sc-yellow) !important;">
            <h4 class="fw-bold fuente-marca mb-1 text-white">SAY CHEESE &bull; PIZZERÍA CONTABLE</h4>
            <h6 class="text-warning mb-0 text-uppercase espaciado-letras-1">Estado de Resultados Integral (Córdobas C$)</h6>
            <small class="text-white-50">Período: Del @Model.FechaDesde.ToString("dd/MM/yyyy") al @Model.FechaHasta.ToString("dd/MM/yyyy")</small>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <tbody>
                    <!-- 1. INGRESOS -->
                    <tr class="fw-bold fs-6" style="background-color: var(--sc-cream);">
                        <td class="text-dark"><i class="bi bi-plus-circle text-success me-2"></i>1. INGRESOS OPERACIONALES</td>
                        <td class="text-end text-success fuente-numerica">C$ @Model.TotalIngresos.ToString("N2")</td>
                    </tr>
                    @foreach (var ing in Model.DetalleIngresos)
                    {
                        <tr>
                            <td class="ps-4 text-muted"><i class="bi bi-chevron-right me-1 text-warning"></i>@ing.Concepto</td>
                            <td class="text-end fuente-numerica text-secondary">C$ @ing.Monto.ToString("N2")</td>
                        </tr>
                    }

                    <!-- 2. COSTO DE VENTAS -->
                    <tr class="fw-bold fs-6" style="background-color: var(--sc-gray-warm);">
                        <td class="text-dark"><i class="bi bi-dash-circle text-danger me-2"></i>2. MENOS: COSTO DE VENTAS (Materia Prima Consumida)</td>
                        <td class="text-end text-danger fuente-numerica">-C$ @Model.TotalCostosVentas.ToString("N2")</td>
                    </tr>

                    <!-- 3. MARGEN BRUTO -->
                    <tr class="fw-bold fs-6" style="background-color: #FEF3E8; border-top: 2px solid var(--sc-orange); border-bottom: 2px solid var(--sc-orange);">
                        <td class="text-dark"><i class="bi bi-calculator text-warning me-2"></i>3. UTILIDAD BRUTA EN VENTAS (MARGEN BRUTO)</td>
                        <td class="text-end @(Model.MargenBruto >= 0 ? "text-success" : "text-danger") fuente-numerica">
                            C$ @Model.MargenBruto.ToString("N2")
                            @if (Model.TotalIngresos > 0)
                            {
                                <span class="badge bg-warning text-dark ms-2 fuente-numerica">@((Model.MargenBruto / Model.TotalIngresos * 100).ToString("N1"))% margen</span>
                            }
                        </td>
                    </tr>

                    <!-- 4. GASTOS OPERATIVOS -->
                    <tr class="fw-bold fs-6" style="background-color: var(--sc-gray-warm);">
                        <td class="text-dark"><i class="bi bi-dash-circle text-danger me-2"></i>4. MENOS: GASTOS OPERATIVOS Y ADMINISTRATIVOS</td>
                        <td class="text-end text-danger fuente-numerica">-C$ @Model.TotalGastosOperativos.ToString("N2")</td>
                    </tr>
                    @foreach (var gas in Model.DetalleGastos)
                    {
                        <tr>
                            <td class="ps-4 text-muted"><i class="bi bi-chevron-right me-1 text-warning"></i>@gas.Concepto</td>
                            <td class="text-end fuente-numerica text-secondary">C$ @gas.Monto.ToString("N2")</td>
                        </tr>
                    }

                    <!-- 5. UTILIDAD NETA -->
                    <tr class="fw-bold fs-5 text-white" style="background: linear-gradient(135deg, #260B08 0%, #150503 100%); border-top: 3px solid var(--sc-yellow);">
                        <td class="fuente-marca text-warning"><i class="bi bi-trophy me-2"></i>5. UTILIDAD OPERATIVA NETA DEL EJERCICIO</td>
                        <td class="text-end @(Model.UtilidadOperativa >= 0 ? "text-success" : "text-danger") fuente-numerica">
                            C$ @Model.UtilidadOperativa.ToString("N2")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
