@model PizzeriaContable.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark py-3">
                    <h2 class="h5 mb-0 fw-bold">Modificar Producto</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-5">
                                <label asp-for="Codigo" class="form-label fw-semibold"></label>
                                <input asp-for="Codigo" class="form-control font-monospace" />
                                <span asp-validation-for="Codigo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-7">
                                <label asp-for="CategoriaId" class="form-label fw-semibold"></label>
                                <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
                                </select>
                                <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Tamano" class="form-label fw-semibold"></label>
                                <input asp-for="Tamano" class="form-control" />
                                <span asp-validation-for="Tamano" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Precio" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">C$</span>
                                    <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" />
                                </div>
                                <span asp-validation-for="Precio" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Activo" />
                            <label class="form-check-label" asp-for="Activo">Disponible para la venta (Activo)</label>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold">Actualizar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
