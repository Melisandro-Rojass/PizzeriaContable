@model IEnumerable<PizzeriaContable.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
    var mostrarInactivos = (bool)(ViewData["MostrarInactivos"] ?? false);
    var searchString = (string?)ViewData["SearchString"];
    var categoriaId = (int?)ViewData["CategoriaId"];
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1 text-gray-800 fw-bold">Catálogo de Productos</h1>
            <p class="text-muted small mb-0">Administra los productos de la pizzería, tamaños, categorías y precios de venta.</p>
        </div>
        <div>
            <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-tags"></i> Categorías
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> + Nuevo Producto
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" class="form-control border-start-0" placeholder="Buscar por nombre o código..." value="@searchString" />
                        <button type="submit" class="btn btn-secondary">Buscar</button>
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoriaId" class="form-select" asp-items="ViewBag.Categorias" onchange="this.form.submit()">
                        <option value="">-- Todas las categorías --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input" type="checkbox" name="mostrarInactivos" value="true" id="checkInactivos" @(mostrarInactivos ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label small" for="checkInactivos">Mostrar inactivos</label>
                    </div>
                </div>
                <div class="col-md-1 text-end">
                    @if (!string.IsNullOrEmpty(searchString) || categoriaId.HasValue || mostrarInactivos)
                    {
                        <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Limpiar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 120px;">Código</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Presentación</th>
                        <th scope="col" class="text-end" style="width: 130px;">Precio</th>
                        <th scope="col" style="width: 110px;" class="text-center">Estado</th>
                        <th scope="col" class="text-end" style="width: 260px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                No se encontraron productos registrados con los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(!item.Activo ? "table-light text-muted" : "")">
                                <td class="font-monospace small">@item.Codigo</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.Categoria?.Nombre ?? "Sin categoría")
                                    </span>
                                </td>
                                <td>@(string.IsNullOrEmpty(item.Tamano) ? "-" : item.Tamano)</td>
                                <td class="text-end fw-bold text-dark">@item.Precio.ToString("C2")</td>
                                <td class="text-center">
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Ver ficha">
                                            Detalles
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                                            Editar
                                        </a>
                                    </div>
                                    <form asp-action="Desactivar" asp-route-id="@item.Id" method="post" class="d-inline ms-1">
                                        @Html.AntiForgeryToken()
                                        @if (item.Activo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar producto">
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivar producto">
                                                Activar
                                            </button>
                                        }
                                    </form>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1" title="Eliminar">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
