@model PizzeriaContable.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h2 class="h5 mb-0 fw-bold">¿Confirmar Eliminación?</h2>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Atención:</strong> Si este producto ya cuenta con registros históricos de ventas, el sistema lo <strong>desactivará</strong> para proteger la integridad contable sin eliminar los registros previos.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Código</dt>
                        <dd class="col-sm-8 font-monospace">@Model.Codigo</dd>

                        <dt class="col-sm-4 text-muted">Nombre</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Nombre</dd>

                        <dt class="col-sm-4 text-muted">Categoría</dt>
                        <dd class="col-sm-8">@(Model.Categoria?.Nombre ?? "Sin categoría")</dd>

                        <dt class="col-sm-4 text-muted">Precio</dt>
                        <dd class="col-sm-8">@Model.Precio.ToString("C2")</dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="d-flex justify-content-between pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold">Confirmar Eliminación</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
