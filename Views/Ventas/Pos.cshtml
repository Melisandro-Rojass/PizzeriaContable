@model IEnumerable<PizzeriaContable.Models.Producto>
@{
    ViewData["Title"] = "Punto de Venta (POS) - Say Cheese Pizza";
    var categorias = ViewBag.Categorias as List<PizzeriaContable.Models.Categoria> ?? new List<PizzeriaContable.Models.Categoria>();
    var sesionCaja = ViewBag.SesionCaja as PizzeriaContable.Models.CajaSesion;
    decimal tasaIva = ViewBag.TasaIva != null ? (decimal)ViewBag.TasaIva : 15.00m;
}

<div class="container-fluid px-0">
    @if (sesionCaja == null)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between mb-3 shadow-sm rounded-3 p-3 border-0" role="alert" style="background-color: var(--sc-cream); border-left: 5px solid var(--sc-orange) !important;">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-2 me-3 text-warning"></i>
                <div>
                    <h5 class="alert-heading mb-0 fw-bold text-dark font-brand">No hay turno de caja abierto</h5>
                    <p class="mb-0 small text-dark">Para asociar las ventas en efectivo al arqueo físico de caja, te recomendamos abrir un turno.</p>
                </div>
            </div>
            <a asp-controller="Caja" asp-action="Index" class="btn btn-warning fw-bold text-dark shadow-sm">
                <i class="bi bi-box-arrow-in-right me-1"></i> Abrir Turno de Caja
            </a>
        </div>
    }

    <div class="row g-3">
        <!-- Panel Izquierdo: Catálogo de Productos y Pizzas -->
        <div class="col-lg-7 col-xl-8">
            <div class="card h-100">
                <div class="card-header bg-white py-3 border-0">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-warning"><i class="bi bi-search"></i></span>
                                <input type="text" id="buscarProducto" class="form-control bg-light border-start-0" placeholder="Buscar pizza, bebida o combo..." />
                            </div>
                        </div>
                        <div class="col-md-7">
                            <!-- Filtro de Categorías con Estilo Say Cheese -->
                            <div class="d-flex gap-1 overflow-auto pb-1" id="categoriaTabs">
                                <button type="button" class="btn btn-sm btn-dark active flex-shrink-0 cat-btn" data-cat="all">
                                    <i class="bi bi-grid-fill me-1"></i>Todas
                                </button>
                                @foreach (var cat in categorias)
                                {
                                    <button type="button" class="btn btn-sm flex-shrink-0 cat-btn" data-cat="@cat.Id">
                                        @cat.Nombre
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body overflow-auto p-3" style="max-height: calc(100vh - 210px); background-color: var(--sc-cream-light);">
                    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3" id="catalogoGrid">
                        @foreach (var prod in Model)
                        {
                            <div class="col item-producto" data-id="@prod.Id" data-cat="@prod.CategoriaId" data-nombre="@prod.Nombre.ToLower()" data-precio="@prod.Precio">
                                <div class="card h-100 product-pos-card shadow-sm text-center p-2 cursor-pointer position-relative bg-white" onclick="agregarAlCarrito(@prod.Id, '@prod.Nombre', @prod.Precio)">
                                    @if (prod.Receta != null)
                                    {
                                        <span class="badge bg-success-subtle text-success position-absolute top-0 end-0 m-2 small fw-bold" title="Con Receta / Descuenta stock">
                                            <i class="bi bi-check-circle-fill"></i> Receta
                                        </span>
                                    }
                                    
                                    <div class="py-2 d-flex justify-content-center align-items-center" style="height: 70px;">
                                        <img src="~/images/pizza-slice.svg" alt="Pizza" style="height: 52px; width: auto; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.15));" />
                                    </div>

                                    <h6 class="card-title fw-bold text-dark mb-1 text-truncate px-1" title="@prod.Nombre">@prod.Nombre</h6>
                                    <span class="text-muted small d-block text-truncate mb-2">@(prod.Categoria?.Nombre ?? "Menú")</span>
                                    
                                    <div class="mt-auto pt-2 border-top" style="border-color: var(--sc-border-warm) !important;">
                                        <span class="price-badge d-block font-numeric">
                                            C$ @prod.Precio.ToString("N2")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel Derecho: Comanda / Orden Actual -->
        <div class="col-lg-5 col-xl-4">
            <div class="card h-100 d-flex flex-column shadow-sm">
                <!-- Header de la comanda con estilo Horno -->
                <div class="card-header text-white py-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #3A130D 0%, #1A0704 100%); border-bottom: 2px solid var(--sc-yellow);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-receipt text-warning fs-5"></i>
                        <span class="fw-bold font-brand fs-6 text-white">Comanda en Curso</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger text-white border-0 py-1 px-2" onclick="limpiarCarrito()" title="Vaciar la comanda">
                        <i class="bi bi-trash"></i> Vaciar
                    </button>
                </div>

                <div class="p-3 bg-light border-bottom" style="border-color: var(--sc-border-warm) !important;">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-person-fill"></i></span>
                        <input type="text" id="clienteNombre" class="form-control" placeholder="Nombre del cliente" value="Cliente General" />
                    </div>
                </div>

                <!-- Lista de Ítems en la orden -->
                <div class="card-body overflow-auto p-2 flex-grow-1" style="max-height: 330px;" id="contenedorItems">
                    <div id="carritoVacio" class="text-center py-5 text-muted">
                        <img src="~/images/pizza-slice.svg" alt="Vacío" style="height: 48px; width: auto; opacity: 0.35; margin-bottom: 0.75rem;" />
                        <span class="d-block fw-semibold text-secondary">No hay productos seleccionados</span>
                        <small class="text-muted">Haz clic en un producto para agregarlo</small>
                    </div>
                    <ul class="list-group list-group-flush" id="listaCarrito"></ul>
                </div>

                <!-- Resumen de Totales y Cobro -->
                <div class="card-footer bg-white border-top p-3" style="border-color: var(--sc-border-warm) !important;">
                    <div class="d-flex justify-content-between text-muted mb-1 small">
                        <span>Subtotal:</span>
                        <span id="txtSubtotal" class="font-numeric fw-semibold">C$ 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted mb-1 small">
                        <span>IVA (@tasaIva%):</span>
                        <span id="txtImpuesto" class="font-numeric fw-semibold">C$ 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                        <span class="text-muted">Descuento Global (C$):</span>
                        <input type="number" id="inpDescuento" class="form-control form-control-sm text-end font-numeric" style="width: 105px; border-color: var(--sc-border-warm);" value="0" min="0" step="1" onchange="recalcularTotales()" />
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2" style="border-color: var(--sc-border-warm) !important;">
                        <div>
                            <span class="d-block small text-muted text-uppercase fw-bold">Total a Cobrar</span>
                            <span class="fs-3 fw-bold font-brand text-success font-numeric" id="txtTotal">C$ 0.00</span>
                        </div>
                        <span class="badge bg-warning text-dark font-numeric px-2 py-1 fw-bold">NIO C$</span>
                    </div>

                    <button type="button" class="btn btn-success btn-lg w-100 mt-3 fw-bold py-2 shadow font-brand fs-5 d-flex align-items-center justify-content-center gap-2" id="btnCobrar" onclick="abrirModalCobro()" disabled>
                        <i class="bi bi-cash-coin fs-4"></i> COBRAR ORDEN
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Cobro con Identidad Say Cheese -->
<div class="modal fade" id="modalCobro" tabindex="-1" aria-labelledby="modalCobroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 18px; overflow: hidden;">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #4A120B 0%, #1A0704 100%); border-bottom: 3px solid var(--sc-yellow);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-wallet2 text-warning fs-5"></i>
                    <h5 class="modal-title fw-bold font-brand text-white" id="modalCobroLabel">Registrar Pago del Pedido</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4 p-3 rounded-3" style="background: linear-gradient(135deg, var(--sc-cream-light) 0%, var(--sc-cream) 100%); border: 2px dashed var(--sc-orange);">
                    <span class="text-muted d-block small fw-bold text-uppercase">Monto Total a Cobrar</span>
                    <span class="fs-1 fw-bold text-success font-numeric font-brand" id="modalTotalCobrar">C$ 0.00</span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Método de Pago</label>
                    <div class="btn-group w-100 shadow-sm" role="group">
                        <input type="radio" class="btn-check" name="metodoPago" id="pagoEfectivo" value="Efectivo" checked onchange="cambiarMetodoPago()">
                        <label class="btn btn-outline-success fw-bold py-2" for="pagoEfectivo"><i class="bi bi-cash me-1"></i> Efectivo</label>

                        <input type="radio" class="btn-check" name="metodoPago" id="pagoTarjeta" value="Tarjeta" onchange="cambiarMetodoPago()">
                        <label class="btn btn-outline-primary fw-bold py-2" for="pagoTarjeta"><i class="bi bi-credit-card me-1"></i> Tarjeta</label>

                        <input type="radio" class="btn-check" name="metodoPago" id="pagoTransf" value="Transferencia" onchange="cambiarMetodoPago()">
                        <label class="btn btn-outline-info fw-bold py-2" for="pagoTransf"><i class="bi bi-phone me-1"></i> Transf.</label>
                    </div>
                </div>

                <!-- Sección Efectivo (Monto entregado y cambio) -->
                <div id="seccionEfectivo" class="mb-3">
                    <label class="form-label fw-bold small text-dark">Efectivo Recibido (C$)</label>
                    <input type="number" id="montoRecibido" class="form-control form-control-lg text-end fw-bold font-numeric" step="1" oninput="calcularCambio()" style="border-color: var(--sc-orange); font-size: 1.4rem;" />
                    <div class="d-flex justify-content-between align-items-center mt-2 p-3 rounded-3" style="background-color: var(--sc-cream); border: 1px solid var(--sc-border-warm);">
                        <span class="fw-bold text-dark"><i class="bi bi-arrow-return-right text-warning me-1"></i> Cambio a entregar:</span>
                        <span class="fs-4 fw-bold text-primary font-numeric font-brand" id="txtCambio">C$ 0.00</span>
                    </div>
                </div>

                <!-- Sección Tarjeta / Transferencia (Referencia) -->
                <div id="seccionReferencia" class="mb-3 d-none">
                    <label class="form-label fw-bold small text-dark">N° de Autorización / Referencia</label>
                    <input type="text" id="numReferencia" class="form-control" placeholder="Ej. LOTE-45892 o Voucher" />
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted fw-semibold">Notas / Observaciones de la orden</label>
                    <textarea id="notasVenta" class="form-control" rows="2" placeholder="Opcional: Para llevar, orilla rellena, mesa #..."></textarea>
                </div>

                <div id="cobroError" class="alert alert-danger d-none small rounded-3 border-0" style="background-color: #FDEDEC; color: #78281F; border-left: 4px solid var(--sc-red) !important;"></div>
            </div>
            <div class="modal-footer bg-light" style="border-top: 1px solid var(--sc-border-warm);">
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success fw-bold px-4 py-2 shadow-sm font-brand" id="btnConfirmarVenta" onclick="procesarVenta()">
                    <span id="spinnerCobro" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                    <i class="bi bi-check-circle me-1"></i> CONFIRMAR VENTA
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Éxito / Ticket -->
<div class="modal fade" id="modalExito" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg text-center p-4" style="border-radius: 20px;">
            <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center overflow-hidden border border-3 border-warning shadow" style="width: 84px; height: 84px; background: #FFF3DE;">
                <img src="~/images/say-cheese-chef.jpg" alt="Chef Say Cheese" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/pizza-slice.svg';" />
            </div>
            <h4 class="fw-bold text-dark font-brand mb-1">¡Venta Completada con Éxito!</h4>
            <p class="text-muted small" id="txtNumeroTicket">Comprobante #TCK-0000</p>
            <div class="p-3 rounded-3 mb-4 mx-auto w-75" style="background-color: var(--sc-cream); border: 1px solid var(--sc-border-warm);">
                <span class="small text-muted d-block fw-bold text-uppercase">Total Pagado</span>
                <span class="fs-2 fw-bold text-success font-numeric font-brand" id="txtTotalExito">C$ 0.00</span>
            </div>

            <div class="d-grid gap-2">
                <a id="btnImprimirTicket" href="#" target="_blank" class="btn btn-outline-dark btn-lg fw-bold py-2">
                    <i class="bi bi-printer me-2"></i> Imprimir Ticket Térmico
                </a>
                <button type="button" class="btn btn-saycheese-primary btn-lg fw-bold py-2 font-brand" onclick="iniciarNuevaVenta()">
                    <i class="bi bi-plus-circle me-2"></i> Siguiente Pedido
                </button>
            </div>
        </div>
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<style>
    .cursor-pointer { cursor: pointer; }
</style>

@section Scripts {
<script>
    let carrito = [];
    const tasaIva = @tasaIva;
    let modalCobroInstancia = null;
    let modalExitoInstancia = null;
    let totalGeneralCalculado = 0;

    document.addEventListener("DOMContentLoaded", function () {
        modalCobroInstancia = new bootstrap.Modal(document.getElementById('modalCobro'));
        modalExitoInstancia = new bootstrap.Modal(document.getElementById('modalExito'));

        // Filtro buscador
        document.getElementById('buscarProducto').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase();
            document.querySelectorAll('.item-producto').forEach(item => {
                const nombre = item.getAttribute('data-nombre');
                item.style.display = nombre.includes(query) ? '' : 'none';
            });
        });

        // Filtro categorías
        document.querySelectorAll('.cat-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.cat-btn').forEach(b => {
                    b.classList.remove('btn-dark', 'active');
                });
                this.classList.add('btn-dark', 'active');

                const cat = this.getAttribute('data-cat');
                document.querySelectorAll('.item-producto').forEach(item => {
                    if (cat === 'all' || item.getAttribute('data-cat') === cat) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });
    });

    function agregarAlCarrito(id, nombre, precio) {
        const existente = carrito.find(x => x.productoId === id);
        if (existente) {
            existente.cantidad += 1;
        } else {
            carrito.push({
                productoId: id,
                nombre: nombre,
                precioUnitario: precio,
                cantidad: 1,
                descuento: 0
            });
        }
        actualizarVistaCarrito();
    }

    function cambiarCantidad(id, delta) {
        const item = carrito.find(x => x.productoId === id);
        if (!item) return;
        item.cantidad += delta;
        if (item.cantidad <= 0) {
            carrito = carrito.filter(x => x.productoId !== id);
        }
        actualizarVistaCarrito();
    }

    function eliminarItem(id) {
        carrito = carrito.filter(x => x.productoId !== id);
        actualizarVistaCarrito();
    }

    function limpiarCarrito() {
        carrito = [];
        actualizarVistaCarrito();
    }

    function recalcularTotales() {
        actualizarVistaCarrito();
    }

    function actualizarVistaCarrito() {
        const lista = document.getElementById('listaCarrito');
        const carritoVacio = document.getElementById('carritoVacio');
        const btnCobrar = document.getElementById('btnCobrar');

        lista.innerHTML = '';

        if (carrito.length === 0) {
            carritoVacio.style.display = 'block';
            btnCobrar.disabled = true;
            document.getElementById('txtSubtotal').innerText = 'C$ 0.00';
            document.getElementById('txtImpuesto').innerText = 'C$ 0.00';
            document.getElementById('txtTotal').innerText = 'C$ 0.00';
            totalGeneralCalculado = 0;
            return;
        }

        carritoVacio.style.display = 'none';
        btnCobrar.disabled = false;

        let subtotal = 0;

        carrito.forEach(item => {
            const itemSubtotal = (item.cantidad * item.precioUnitario) - item.descuento;
            subtotal += itemSubtotal;

            const li = document.createElement('li');
            li.className = 'list-group-item d-flex justify-content-between align-items-center px-2 py-2 mb-1 rounded-2 border';
            li.style.borderColor = 'var(--sc-border-warm)';
            li.style.backgroundColor = '#FFFFFF';
            li.innerHTML = `
                <div class="me-auto">
                    <div class="fw-bold text-dark text-truncate" style="max-width: 160px;">${item.nombre}</div>
                    <small class="text-muted font-numeric">C$ ${item.precioUnitario.toFixed(2)} c/u</small>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-outline-secondary px-2 py-0 fw-bold" onclick="cambiarCantidad(${item.productoId}, -1)">-</button>
                    <span class="fw-bold px-1 font-numeric">${item.cantidad}</span>
                    <button class="btn btn-sm btn-outline-secondary px-2 py-0 fw-bold" onclick="cambiarCantidad(${item.productoId}, 1)">+</button>
                    <span class="fw-bold text-dark ms-2 font-numeric" style="min-width: 65px; text-align: right;">C$ ${itemSubtotal.toFixed(2)}</span>
                    <button class="btn btn-sm text-danger ms-1 p-0" onclick="eliminarItem(${item.productoId})"><i class="bi bi-x-circle-fill"></i></button>
                </div>
            `;
            lista.appendChild(li);
        });

        const descuentoGlobal = parseFloat(document.getElementById('inpDescuento').value) || 0;
        const impuesto = Math.round(subtotal * (tasaIva / 100) * 100) / 100;
        const total = Math.max(0, subtotal + impuesto - descuentoGlobal);
        totalGeneralCalculado = total;

        document.getElementById('txtSubtotal').innerText = `C$ ${subtotal.toFixed(2)}`;
        document.getElementById('txtImpuesto').innerText = `C$ ${impuesto.toFixed(2)}`;
        document.getElementById('txtTotal').innerText = `C$ ${total.toFixed(2)}`;
    }

    function abrirModalCobro() {
        if (carrito.length === 0) return;
        document.getElementById('modalTotalCobrar').innerText = `C$ ${totalGeneralCalculado.toFixed(2)}`;
        document.getElementById('montoRecibido').value = totalGeneralCalculado.toFixed(2);
        document.getElementById('cobroError').classList.add('d-none');
        cambiarMetodoPago();
        calcularCambio();
        modalCobroInstancia.show();
    }

    function cambiarMetodoPago() {
        const metodo = document.querySelector('input[name="metodoPago"]:checked').value;
        const seccionEfectivo = document.getElementById('seccionEfectivo');
        const seccionRef = document.getElementById('seccionReferencia');

        if (metodo === 'Efectivo') {
            seccionEfectivo.classList.remove('d-none');
            seccionRef.classList.add('d-none');
            calcularCambio();
        } else {
            seccionEfectivo.classList.add('d-none');
            seccionRef.classList.remove('d-none');
        }
    }

    function calcularCambio() {
        const recibido = parseFloat(document.getElementById('montoRecibido').value) || 0;
        const cambio = Math.max(0, recibido - totalGeneralCalculado);
        document.getElementById('txtCambio').innerText = `C$ ${cambio.toFixed(2)}`;
    }

    async function procesarVenta() {
        const metodo = document.querySelector('input[name="metodoPago"]:checked').value;
        const cliente = document.getElementById('clienteNombre').value.trim() || 'Cliente General';
        const notas = document.getElementById('notasVenta').value.trim();
        const descuentoGlobal = parseFloat(document.getElementById('inpDescuento').value) || 0;
        const errorDiv = document.getElementById('cobroError');
        const btnConfirmar = document.getElementById('btnConfirmarVenta');
        const spinner = document.getElementById('spinnerCobro');

        if (metodo === 'Efectivo') {
            const recibido = parseFloat(document.getElementById('montoRecibido').value) || 0;
            if (recibido < totalGeneralCalculado) {
                errorDiv.innerText = `El monto recibido (C$ ${recibido.toFixed(2)}) es menor que el total a cobrar (C$ ${totalGeneralCalculado.toFixed(2)}).`;
                errorDiv.classList.remove('d-none');
                return;
            }
        }

        const referencia = metodo !== 'Efectivo' ? document.getElementById('numReferencia').value.trim() : null;

        const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

        const dto = {
            clienteNombre: cliente,
            observaciones: notas,
            descuentoGeneral: descuentoGlobal,
            items: carrito.map(i => ({
                productoId: i.productoId,
                cantidad: i.cantidad,
                precioUnitario: i.precioUnitario,
                descuento: i.descuento
            })),
            pagos: [
                {
                    metodoPago: metodo,
                    monto: totalGeneralCalculado,
                    referencia: referencia
                }
            ]
        };

        btnConfirmar.disabled = true;
        spinner.classList.remove('d-none');
        errorDiv.classList.add('d-none');

        try {
            const response = await fetch('/Ventas/Checkout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(dto)
            });

            const result = await response.json();

            if (result.success) {
                modalCobroInstancia.hide();
                document.getElementById('txtNumeroTicket').innerText = `Ticket N°: ${result.numeroComprobante}`;
                document.getElementById('txtTotalExito').innerText = `C$ ${result.total.toFixed(2)}`;
                document.getElementById('btnImprimirTicket').href = `/Ventas/Ticket/${result.ventaId}`;
                modalExitoInstancia.show();
            } else {
                errorDiv.innerText = result.message || 'Error al procesar la venta.';
                errorDiv.classList.remove('d-none');
            }
        } catch (err) {
            errorDiv.innerText = 'Error de conexión con el servidor: ' + err.message;
            errorDiv.classList.remove('d-none');
        } finally {
            btnConfirmar.disabled = false;
            spinner.classList.add('d-none');
        }
    }

    function iniciarNuevaVenta() {
        modalExitoInstancia.hide();
        limpiarCarrito();
        document.getElementById('clienteNombre').value = 'Cliente General';
        document.getElementById('inpDescuento').value = 0;
        document.getElementById('notasVenta').value = '';
        document.getElementById('numReferencia').value = '';
    }
</script>
}
