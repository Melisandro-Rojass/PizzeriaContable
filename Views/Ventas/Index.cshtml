@model IEnumerable<PizzeriaContable.Models.Venta>
@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Historial de Ventas</h2>
            <p class="text-muted small mb-0">Consulta, arqueo, reimpresión y anulación de tickets emitidos</p>
        </div>
        <a asp-action="Pos" class="btn btn-warning fw-bold text-dark shadow-sm">
            <i class="bi bi-cart-plus-fill me-1"></i> Ir al Punto de Venta (POS)
        </a>
    </div>

    <!-- Tarjetas de Resumen -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white p-3">
                <span class="small text-white-50">Total Facturado (Completadas)</span>
                <h3 class="fw-bold mb-0">C$ @(((decimal)(ViewBag.TotalVentas ?? 0m)).ToString("N2"))</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white p-3">
                <span class="small text-white-50">Impuestos IVA (15%) Recaudados</span>
                <h3 class="fw-bold mb-0">C$ @(((decimal)(ViewBag.TotalImpuestos ?? 0m)).ToString("N2"))</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-dark text-white p-3">
                <span class="small text-white-50">Tickets Efectivos Emitidos</span>
                <h3 class="fw-bold mb-0">@(ViewBag.CantidadCompletadas ?? 0) ventas</h3>
            </div>
        </div>
    </div>

    <!-- Filtros de Búsqueda -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Fecha Inicio</label>
                    <input type="date" name="fechaInicio" class="form-control form-control-sm" value="@ViewBag.FechaInicio" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Fecha Fin</label>
                    <input type="date" name="fechaFin" class="form-control form-control-sm" value="@ViewBag.FechaFin" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Estado</label>
                    <select name="estado" class="form-select form-select-sm">
                        <option value="">Todos los Estados</option>
                        <option value="Completada" selected="@(ViewBag.Estado == "Completada")">Completada</option>
                        <option value="Anulada" selected="@(ViewBag.Estado == "Anulada")">Anulada</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                        <i class="bi bi-filter me-1"></i> Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Ventas -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Ticket</th>
                        <th>Fecha y Hora</th>
                        <th>Cliente</th>
                        <th>Método Pago</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">IVA</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No se encontraron registros de ventas en el período seleccionado.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-primary">
                                    @item.NumeroComprobante
                                </a>
                            </td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.ClienteNombre ?? "General")</td>
                            <td>
                                @if (item.MetodoPago == "Efectivo")
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-cash"></i> Efectivo</span>
                                }
                                else if (item.MetodoPago == "Tarjeta")
                                {
                                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-credit-card"></i> Tarjeta</span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-phone"></i> @item.MetodoPago</span>
                                }
                            </td>
                            <td class="text-end">C$ @item.Subtotal.ToString("N2")</td>
                            <td class="text-end">C$ @item.Impuesto.ToString("N2")</td>
                            <td class="text-end fw-bold">C$ @item.Total.ToString("N2")</td>
                            <td class="text-center">
                                @if (item.Estado == "Completada")
                                {
                                    <span class="badge bg-success">Completada</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Anulada</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Ticket" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-dark" title="Imprimir Ticket">
                                    <i class="bi bi-printer"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Ver Detalle">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
