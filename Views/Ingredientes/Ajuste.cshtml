@{
    var ingrediente = (PizzeriaContable.Models.Ingrediente)ViewBag.Ingrediente;
    ViewData["Title"] = $"Ajuste de Stock: {ingrediente.Nombre}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark py-3">
                    <h2 class="h5 mb-0 fw-bold">Ajuste de Inventario / Mermas</h2>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                        <div>
                            <span class="text-muted small d-block">Ingrediente:</span>
                            <span class="fw-bold fs-6">@ingrediente.Nombre</span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small d-block">Stock Actual:</span>
                            <span class="badge bg-primary fs-6">@ingrediente.StockActual.ToString("0.###") @ingrediente.UnidadMedida</span>
                        </div>
                    </div>

                    <form asp-action="Ajuste" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@ingrediente.Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tipo de Ajuste</label>
                            <select name="tipoAjuste" class="form-select">
                                <option value="SalidaMerma">Merma o Desperdicio (Resta stock)</option>
                                <option value="AjusteNegativo">Ajuste por Faltante en Conteo Físico (Resta stock)</option>
                                <option value="AjustePositivo">Ajuste por Sobrante en Conteo Físico (Suma stock)</option>
                                <option value="Devolucion">Devolución / Entrada Extraordinaria (Suma stock)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Cantidad (@ingrediente.UnidadMedida)</label>
                            <input type="number" step="0.001" min="0.001" name="cantidad" class="form-control" placeholder="0.00" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Motivo / Observaciones</label>
                            <textarea name="observaciones" class="form-control" rows="3" placeholder="Indicar causa: vencimiento, caída, conteo semanal..." required></textarea>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold">Registrar Ajuste en Kardex</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
