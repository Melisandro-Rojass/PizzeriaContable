@model IEnumerable<PizzeriaContable.Models.MovimientoInventario>

@{
    var ingrediente = (PizzeriaContable.Models.Ingrediente)ViewBag.Ingrediente;
    ViewData["Title"] = $"Kardex de {ingrediente.Nombre}";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1 text-gray-800 fw-bold">Historial de Movimientos (Kardex)</h1>
            <p class="text-muted small mb-0">Trazabilidad de entradas, salidas por ventas, mermas y ajustes para <strong>@ingrediente.Nombre</strong>.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver al inventario
            </a>
        </div>
    </div>

    <!-- Ingrediente Summary Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row text-center">
                <div class="col-md-3">
                    <span class="text-muted small">Código</span>
                    <div class="fw-bold font-monospace">@ingrediente.Codigo</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small">Stock Actual</span>
                    <div class="h5 fw-bold text-primary mb-0">@ingrediente.StockActual.ToString("0.###") @ingrediente.UnidadMedida</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small">Costo Unitario Ponderado</span>
                    <div class="fw-bold text-dark">@ingrediente.CostoUnitario.ToString("C2")</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small">Valor de Existencia</span>
                    <div class="fw-bold text-success">@((ingrediente.StockActual * ingrediente.CostoUnitario).ToString("C2"))</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Movements Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Tipo de Movimiento</th>
                        <th>Referencia</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Costo Unitario</th>
                        <th class="text-end">Monto Total</th>
                        <th>Usuario</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No se han registrado movimientos de inventario para este ingrediente.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var m in Model)
                        {
                            bool esEntrada = m.Cantidad > 0;
                            <tr>
                                <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @switch (m.TipoMovimiento)
                                    {
                                        case "EntradaCompra":
                                            <span class="badge bg-success-subtle text-success border">Entrada por Compra</span>
                                            break;
                                        case "SalidaVenta":
                                            <span class="badge bg-primary-subtle text-primary border">Salida por Venta</span>
                                            break;
                                        case "SalidaMerma":
                                            <span class="badge bg-danger-subtle text-danger border">Merma</span>
                                            break;
                                        case "InventarioInicial":
                                            <span class="badge bg-info-subtle text-info border">Inventario Inicial</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border">@m.TipoMovimiento</span>
                                            break;
                                    }
                                </td>
                                <td class="font-monospace">@(m.Referencia ?? "-")</td>
                                <td class="text-end fw-bold @(esEntrada ? "text-success" : "text-danger")">
                                    @(esEntrada ? "+" : "")@m.Cantidad.ToString("0.###") @ingrediente.UnidadMedida
                                </td>
                                <td class="text-end">@m.CostoUnitario.ToString("C2")</td>
                                <td class="text-end fw-semibold">@m.Total.ToString("C2")</td>
                                <td>@(m.UsuarioId ?? "Sistema")</td>
                                <td class="text-muted">@(m.Observaciones ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
