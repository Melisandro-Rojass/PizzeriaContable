@model PizzeriaContable.ViewModels.AsientoManualViewModel
@{
    ViewData["Title"] = "Registrar Asiento Contable Manual";
    var cuentas = ViewBag.Cuentas as List<PizzeriaContable.Models.CuentaContable> ?? new List<PizzeriaContable.Models.CuentaContable>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Nuevo Asiento Manual</h2>
            <p class="text-muted small mb-0">Registro manual de ajustes, depreciaciones o reclasificaciones con validación de partida doble</p>
        </div>
        <a asp-action="Asientos" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al Libro Diario
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <div asp-validation-summary="All" class="text-danger mb-0"></div>
        </div>
    }

    <form asp-action="CrearAsiento" method="post" id="formAsiento">
        @Html.AntiForgeryToken()

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold mb-0">Cabecera del Asiento</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="Fecha" class="form-label fw-bold"></label>
                        <input asp-for="Fecha" type="date" class="form-control" required />
                        <span asp-validation-for="Fecha" class="text-danger small"></span>
                    </div>
                    <div class="col-md-9">
                        <label asp-for="Concepto" class="form-label fw-bold"></label>
                        <input asp-for="Concepto" class="form-control" placeholder="Ej. Depreciación de hornos del mes / Ajuste de inventario por merma" required />
                        <span asp-validation-for="Concepto" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0">Movimientos / Partida Doble</h5>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="agregarFila()">
                    <i class="bi bi-plus-circle me-1"></i> Agregar Línea
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0" id="tablaLineas">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%;">Cuenta Contable <span class="text-danger">*</span></th>
                            <th>Descripción / Detalle</th>
                            <th style="width: 15%;" class="text-end">Debe (C$)</th>
                            <th style="width: 15%;" class="text-end">Haber (C$)</th>
                            <th style="width: 50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="filasContenedor">
                        <!-- Filas dinámicas generadas por JS -->
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="2" class="text-end">Sumas Iguales:</td>
                            <td class="text-end"><span id="txtTotalDebe" class="fs-6 text-primary">C$ 0.00</span></td>
                            <td class="text-end"><span id="txtTotalHaber" class="fs-6 text-success">C$ 0.00</span></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2" class="text-end">Diferencia:</td>
                            <td colspan="2" class="text-center">
                                <span id="txtDiferencia" class="badge bg-success fs-6">CUADRADO (C$ 0.00)</span>
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mb-5">
            <a asp-action="Asientos" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary fw-bold px-4" id="btnGuardar" disabled>
                <i class="bi bi-save me-1"></i> Guardar Asiento Contable
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const cuentasDisponibles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cuentas.Select(c => new { c.Id, c.Codigo, c.Nombre })));
    let indexFila = 0;

    document.addEventListener("DOMContentLoaded", function () {
        // Inicializar con dos filas mínimas
        agregarFila();
        agregarFila();
    });

    function agregarFila() {
        const tbody = document.getElementById('filasContenedor');
        const tr = document.createElement('tr');
        tr.id = `fila_${indexFila}`;

        let selectOptions = '<option value="">-- Seleccionar Cuenta --</option>';
        cuentasDisponibles.forEach(c => {
            selectOptions += `<option value="${c.Id}">${c.Codigo} - ${c.Nombre}</option>`;
        });

        tr.innerHTML = `
            <td>
                <select name="Lineas[${indexFila}].CuentaContableId" class="form-select form-select-sm" required>
                    ${selectOptions}
                </select>
            </td>
            <td>
                <input type="text" name="Lineas[${indexFila}].Descripcion" class="form-control form-control-sm" placeholder="Detalle..." />
            </td>
            <td>
                <input type="number" name="Lineas[${indexFila}].Debe" class="form-control form-control-sm text-end inp-debe" value="0.00" step="0.01" min="0" oninput="validarExclusion(this, 'haber'); recalcular();" />
            </td>
            <td>
                <input type="number" name="Lineas[${indexFila}].Haber" class="form-control form-control-sm text-end inp-haber" value="0.00" step="0.01" min="0" oninput="validarExclusion(this, 'debe'); recalcular();" />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarFila('fila_${indexFila}')">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

        tbody.appendChild(tr);
        indexFila++;
        recalcular();
    }

    function eliminarFila(id) {
        const row = document.getElementById(id);
        if (row) {
            row.remove();
            recalcular();
        }
    }

    function validarExclusion(input, target) {
        const val = parseFloat(input.value) || 0;
        const parentTr = input.closest('tr');
        if (val > 0) {
            const targetInp = parentTr.querySelector(target === 'debe' ? '.inp-debe' : '.inp-haber');
            if (targetInp) targetInp.value = "0.00";
        }
    }

    function recalcular() {
        let totalDebe = 0;
        let totalHaber = 0;

        document.querySelectorAll('.inp-debe').forEach(inp => {
            totalDebe += parseFloat(inp.value) || 0;
        });

        document.querySelectorAll('.inp-haber').forEach(inp => {
            totalHaber += parseFloat(inp.value) || 0;
        });

        document.getElementById('txtTotalDebe').innerText = `C$ ${totalDebe.toFixed(2)}`;
        document.getElementById('txtTotalHaber').innerText = `C$ ${totalHaber.toFixed(2)}`;

        const diff = Math.abs(totalDebe - totalHaber);
        const badgeDiff = document.getElementById('txtDiferencia');
        const btnGuardar = document.getElementById('btnGuardar');

        if (diff < 0.01 && totalDebe > 0) {
            badgeDiff.className = 'badge bg-success fs-6';
            badgeDiff.innerText = `CUADRADO (C$ 0.00)`;
            btnGuardar.disabled = false;
        } else {
            badgeDiff.className = 'badge bg-danger fs-6';
            badgeDiff.innerText = `DESCUADRADO: C$ ${diff.toFixed(2)}`;
            btnGuardar.disabled = true;
        }
    }
</script>
}
