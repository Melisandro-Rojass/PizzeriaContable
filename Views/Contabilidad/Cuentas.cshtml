@model IEnumerable<PizzeriaContable.Models.CuentaContable>
@{
    ViewData["Title"] = "Catálogo de Cuentas Contables";
    var cuentasPadre = ViewBag.CuentasPadre as List<PizzeriaContable.Models.CuentaContable> ?? new List<PizzeriaContable.Models.CuentaContable>();
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-diagram-3 me-2 text-primary"></i>Catálogo de Cuentas</h2>
            <p class="text-muted small mb-0">Estructura del plan contable adaptado a la gastronomía y pizzería</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CuentasT" class="btn btn-outline-primary fw-bold shadow-sm">
                <i class="bi bi-layout-split me-1"></i> Ver en Cuentas T
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearCuenta">
                <i class="bi bi-plus-circle me-1"></i> Nueva Cuenta Contable
            </button>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold">Buscar por código o nombre</label>
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Ej. 1.1 o Caja" value="@ViewBag.Search" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Tipo de Cuenta</label>
                    <select name="tipo" class="form-select form-select-sm">
                        <option value="">Todos los Tipos</option>
                        <option value="Activo" selected="@(ViewBag.Tipo == "Activo")">1 - Activo</option>
                        <option value="Pasivo" selected="@(ViewBag.Tipo == "Pasivo")">2 - Pasivo</option>
                        <option value="Capital" selected="@(ViewBag.Tipo == "Capital")">3 - Capital</option>
                        <option value="Ingreso" selected="@(ViewBag.Tipo == "Ingreso")">4 - Ingreso</option>
                        <option value="Costo" selected="@(ViewBag.Tipo == "Costo")">5 - Costo de Ventas</option>
                        <option value="Gasto" selected="@(ViewBag.Tipo == "Gasto")">6 - Gastos Operativos</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-search me-1"></i> Filtrar</button>
                    <a asp-action="Cuentas" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla del Catálogo -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Código</th>
                        <th>Nombre de la Cuenta</th>
                        <th>Tipo</th>
                        <th>Naturaleza</th>
                        <th class="text-center">Nivel</th>
                        <th class="text-center">Movimientos</th>
                        <th class="text-end" style="width: 140px;">Saldo Actual</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var saldos = ViewBag.Saldos as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
                    }
                    @foreach (var cta in Model)
                    {
                        string badgeColor = cta.TipoCuenta switch
                        {
                            "Activo" => "bg-primary",
                            "Pasivo" => "bg-warning text-dark",
                            "Capital" => "bg-info text-dark",
                            "Ingreso" => "bg-success",
                            "Costo" => "bg-danger",
                            "Gasto" => "bg-secondary",
                            _ => "bg-light text-dark"
                        };

                        decimal saldoCuenta = saldos.TryGetValue(cta.Codigo, out var sVal) ? sVal : 0m;

                        <tr class="@(!cta.PermiteMovimiento ? "table-light fw-bold" : "")">
                            <td>
                                <span class="font-monospace fw-bold">@cta.Codigo</span>
                            </td>
                            <td>
                                <span style="padding-left: @((cta.Nivel - 1) * 20)px;">
                                    @if (!cta.PermiteMovimiento)
                                    {
                                        <i class="bi bi-folder2 text-secondary me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-text text-muted me-1"></i>
                                    }
                                    @cta.Nombre
                                </span>
                            </td>
                            <td>
                                <span class="badge @badgeColor">@cta.TipoCuenta</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@cta.Naturaleza</span>
                            </td>
                            <td class="text-center">@cta.Nivel</td>
                            <td class="text-center">
                                @if (cta.PermiteMovimiento)
                                {
                                    <span class="badge bg-success-subtle text-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">No (Rubro)</span>
                                }
                            </td>
                            <td class="text-end font-monospace fw-bold @(saldoCuenta > 0 ? "text-primary" : "text-muted")">
                                @(cta.PermiteMovimiento ? $"C$ {saldoCuenta:N2}" : "-")
                            </td>
                            <td class="text-end">
                                @if (cta.PermiteMovimiento)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="CuentaT" asp-route-id="@cta.Id" class="btn btn-primary" title="Ver Cuenta T">
                                            <i class="bi bi-layout-split me-1"></i> Cuenta T
                                        </a>
                                        <a asp-action="LibroMayor" asp-route-id="@cta.Id" class="btn btn-outline-secondary" title="Ver Libro Mayor">
                                            <i class="bi bi-journal-album"></i>
                                        </a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Crear Cuenta -->
<div class="modal fade" id="modalCrearCuenta" tabindex="-1" aria-labelledby="modalCrearCuentaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="CrearCuenta" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalCrearCuentaLabel"><i class="bi bi-plus-circle me-2"></i>Nueva Cuenta Contable</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Código Contable <span class="text-danger">*</span></label>
                        <input type="text" name="Codigo" class="form-control" placeholder="Ej. 1.1.01.03" required />
                        <small class="text-muted">Utilice la convención numérica por niveles.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre de la Cuenta <span class="text-danger">*</span></label>
                        <input type="text" name="Nombre" class="form-control" placeholder="Ej. Caja Chica Sucursal" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tipo de Cuenta</label>
                            <select name="TipoCuenta" class="form-select" required>
                                <option value="Activo">Activo</option>
                                <option value="Pasivo">Pasivo</option>
                                <option value="Capital">Capital</option>
                                <option value="Ingreso">Ingreso</option>
                                <option value="Costo">Costo</option>
                                <option value="Gasto">Gasto</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Naturaleza</label>
                            <select name="Naturaleza" class="form-select" required>
                                <option value="Deudora">Deudora</option>
                                <option value="Acreedora">Acreedora</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nivel Jerárquico</label>
                            <input type="number" name="Nivel" class="form-control" value="4" min="1" max="5" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Cuenta Padre</label>
                            <select name="CuentaPadreId" class="form-select">
                                <option value="">(Ninguna / Raíz)</option>
                                @foreach (var p in cuentasPadre)
                                {
                                    <option value="@p.Id">@p.Codigo - @p.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="PermiteMovimiento" value="true" checked id="chkMov" />
                        <label class="form-check-label fw-bold" for="chkMov">Permite Movimientos Directos (Imputable)</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold">Guardar Cuenta</button>
                </div>
            </form>
        </div>
    </div>
</div>
