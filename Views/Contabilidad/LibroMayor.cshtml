@model (PizzeriaContable.Models.CuentaContable cuenta, List<PizzeriaContable.Models.AsientoDetalle> movimientos)
@{
    ViewData["Title"] = $"Libro Mayor - {Model.cuenta.Codigo} {Model.cuenta.Nombre}";
    decimal saldoDeudor = ViewBag.SaldoDeudor != null ? (decimal)ViewBag.SaldoDeudor : 0m;
    decimal saldoAcreedor = ViewBag.SaldoAcreedor != null ? (decimal)ViewBag.SaldoAcreedor : 0m;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-journal-album me-2 text-primary"></i>Libro Mayor</h2>
            <p class="text-muted small mb-0">Cuenta: <span class="font-monospace fw-bold">@Model.cuenta.Codigo</span> - <strong>@Model.cuenta.Nombre</strong> (@Model.cuenta.Naturaleza)</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Imprimir Mayor
            </button>
            <a asp-action="Cuentas" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
            </a>
        </div>
    </div>

    <!-- Filtros de Fecha -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Desde</label>
                    <input type="date" name="desde" class="form-control form-control-sm" value="@ViewBag.Desde" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Hasta</label>
                    <input type="date" name="hasta" class="form-control form-control-sm" value="@ViewBag.Hasta" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-filter me-1"></i> Filtrar</button>
                    <a asp-action="LibroMayor" asp-route-id="@Model.cuenta.Id" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tarjetas de Saldo -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-light p-3">
                <span class="small text-muted fw-bold">SALDO DEUDOR (C$)</span>
                <h3 class="fw-bold mb-0 text-primary">C$ @saldoDeudor.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-light p-3">
                <span class="small text-muted fw-bold">SALDO ACREEDOR (C$)</span>
                <h3 class="fw-bold mb-0 text-success">C$ @saldoAcreedor.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <!-- Tabla de Movimientos -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 120px;">Fecha</th>
                        <th style="width: 150px;">N° Asiento</th>
                        <th>Concepto / Glosa</th>
                        <th class="text-end" style="width: 150px;">Debe</th>
                        <th class="text-end" style="width: 150px;">Haber</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.movimientos.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No se encontraron movimientos para esta cuenta en el rango seleccionado.
                            </td>
                        </tr>
                    }
                    @foreach (var mov in Model.movimientos)
                    {
                        <tr>
                            <td>@mov.AsientoContable?.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-action="DetalleAsiento" asp-route-id="@mov.AsientoContableId" class="text-decoration-none font-monospace fw-bold">
                                    @mov.AsientoContable?.NumeroAsiento
                                </a>
                            </td>
                            <td>
                                <div>@mov.AsientoContable?.Concepto</div>
                                @if (!string.IsNullOrEmpty(mov.Descripcion))
                                {
                                    <small class="text-muted">@mov.Descripcion</small>
                                }
                            </td>
                            <td class="text-end fw-bold text-dark">@(mov.Debe > 0 ? $"C$ {mov.Debe:N2}" : "-")</td>
                            <td class="text-end fw-bold text-dark">@(mov.Haber > 0 ? $"C$ {mov.Haber:N2}" : "-")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="3" class="text-end">Totales de Movimiento:</td>
                        <td class="text-end text-primary">C$ @Model.movimientos.Sum(m => m.Debe).ToString("N2")</td>
                        <td class="text-end text-success">C$ @Model.movimientos.Sum(m => m.Haber).ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
