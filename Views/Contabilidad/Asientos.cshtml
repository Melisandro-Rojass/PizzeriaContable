@model IEnumerable<PizzeriaContable.Models.AsientoContable>
@{
    ViewData["Title"] = "Libro Diario General";
    decimal totalDebe = ViewBag.TotalDebe != null ? (decimal)ViewBag.TotalDebe : 0m;
    decimal totalHaber = ViewBag.TotalHaber != null ? (decimal)ViewBag.TotalHaber : 0m;
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Libro Diario General</h2>
            <p class="text-muted small mb-0">Registro cronológico de todas las transacciones bajo el principio de partida doble</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CrearAsiento" class="btn btn-primary fw-bold">
                <i class="bi bi-plus-circle me-1"></i> Nuevo Asiento Manual
            </a>
            <a asp-action="Apertura" class="btn btn-outline-dark">
                <i class="bi bi-door-open me-1"></i> Asiento de Apertura
            </a>
        </div>
    </div>

    <!-- Resumen de Cuadre -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-light p-3">
                <span class="small text-muted fw-bold">TOTAL SUMAS DEL DEBE (VÁLIDOS)</span>
                <h3 class="fw-bold mb-0 text-primary">C$ @totalDebe.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-light p-3">
                <span class="small text-muted fw-bold">TOTAL SUMAS DEL HABER (VÁLIDOS)</span>
                <h3 class="fw-bold mb-0 text-success">C$ @totalHaber.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Fecha Desde</label>
                    <input type="date" name="desde" class="form-control form-control-sm" value="@ViewBag.Desde" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Fecha Hasta</label>
                    <input type="date" name="hasta" class="form-control form-control-sm" value="@ViewBag.Hasta" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Origen</label>
                    <select name="tipoOrigen" class="form-select form-select-sm">
                        <option value="">Todos los Orígenes</option>
                        <option value="Venta" selected="@(ViewBag.TipoOrigen == "Venta")">Ventas</option>
                        <option value="Compra" selected="@(ViewBag.TipoOrigen == "Compra")">Compras de Materia Prima</option>
                        <option value="Gasto" selected="@(ViewBag.TipoOrigen == "Gasto")">Gastos Operativos</option>
                        <option value="Apertura" selected="@(ViewBag.TipoOrigen == "Apertura")">Apertura Contable</option>
                        <option value="Manual" selected="@(ViewBag.TipoOrigen == "Manual")">Manual / Ajustes</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-filter me-1"></i> Filtrar</button>
                    <a asp-action="Asientos" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista de Asientos -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
            <h5>No hay asientos contables registrados para este período.</h5>
        </div>
    }
    @foreach (var asiento in Model)
    {
        <div class="card border-0 shadow-sm mb-3 @(asiento.Anulado ? "border-start border-danger border-4" : "border-start border-primary border-4")">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold font-monospace fs-6">@asiento.NumeroAsiento</span>
                    <span class="badge bg-secondary">@asiento.TipoOrigen</span>
                    @if (asiento.Anulado)
                    {
                        <span class="badge bg-danger">ANULADO</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle"></i> Equilibrado</span>
                    }
                </div>
                <div class="text-muted small">
                    <i class="bi bi-calendar3 me-1"></i> @asiento.Fecha.ToString("dd/MM/yyyy") |
                    <i class="bi bi-person me-1"></i> @(asiento.CreadoPor ?? "Sistema")
                </div>
            </div>
            <div class="card-body p-3">
                <p class="mb-2 text-dark fw-bold">@asiento.Concepto</p>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-muted">
                                <th style="width: 140px;">Código</th>
                                <th>Cuenta Contable</th>
                                <th>Referencia / Detalle</th>
                                <th class="text-end" style="width: 130px;">Debe</th>
                                <th class="text-end" style="width: 130px;">Haber</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in asiento.Detalles)
                            {
                                <tr>
                                    <td class="font-monospace small">@linea.CuentaContable?.Codigo</td>
                                    <td>@linea.CuentaContable?.Nombre</td>
                                    <td class="small text-muted">@linea.Descripcion</td>
                                    <td class="text-end fw-bold @(linea.Debe > 0 ? "text-dark" : "text-muted")">
                                        @(linea.Debe > 0 ? $"C$ {linea.Debe:N2}" : "-")
                                    </td>
                                    <td class="text-end fw-bold @(linea.Haber > 0 ? "text-dark" : "text-muted")">
                                        @(linea.Haber > 0 ? $"C$ {linea.Haber:N2}" : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light small fw-bold">
                            <tr>
                                <td colspan="3" class="text-end">Totales del Asiento:</td>
                                <td class="text-end text-primary">C$ @asiento.Detalles.Sum(d => d.Debe).ToString("N2")</td>
                                <td class="text-end text-success">C$ @asiento.Detalles.Sum(d => d.Haber).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
