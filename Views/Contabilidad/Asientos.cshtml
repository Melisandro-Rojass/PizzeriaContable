@model IEnumerable<PizzeriaContable.Models.AsientoContable>
@{
    ViewData["Title"] = "Libro Diario General";
    decimal totalDebe = ViewBag.TotalDebe != null ? (decimal)ViewBag.TotalDebe : 0m;
    decimal totalHaber = ViewBag.TotalHaber != null ? (decimal)ViewBag.TotalHaber : 0m;
    var cuentas = ViewBag.Cuentas as List<PizzeriaContable.Models.CuentaContable> ?? new List<PizzeriaContable.Models.CuentaContable>();
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Libro Diario General</h2>
            <p class="text-muted small mb-0">Registro cronológico de todas las transacciones bajo el principio de partida doble</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CuentasT" class="btn btn-outline-primary fw-bold shadow-sm">
                <i class="bi bi-layout-split me-1"></i> Cuentas T (Mayor)
            </a>
            <form asp-action="CargarEjemploDidactico" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success fw-bold shadow-sm" title="Venta de contado didáctica por C$ 1,000">
                    <i class="bi bi-lightning-charge me-1"></i> Asiento Didáctico (C$ 1,000)
                </button>
            </form>
            <a asp-action="CrearAsiento" class="btn btn-primary fw-bold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Nuevo Asiento Manual
            </a>
            <a asp-action="Apertura" class="btn btn-outline-dark shadow-sm">
                <i class="bi bi-door-open me-1"></i> Asiento Apertura
            </a>
        </div>
    </div>

    <!-- Resumen de Cuadre -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-white border-start border-primary border-4 p-3">
                <span class="small text-muted fw-bold">TOTAL SUMAS DEL DEBE (VÁLIDOS)</span>
                <h3 class="fw-bold mb-0 text-primary">C$ @totalDebe.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-white border-start border-success border-4 p-3">
                <span class="small text-muted fw-bold">TOTAL SUMAS DEL HABER (VÁLIDOS)</span>
                <h3 class="fw-bold mb-0 text-success">C$ @totalHaber.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Buscar N° o Concepto</label>
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Buscar..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Filtrar por Cuenta</label>
                    <select name="cuentaId" class="form-select form-select-sm">
                        <option value="">Todas las Cuentas</option>
                        @foreach (var c in cuentas)
                        {
                            <option value="@c.Id" selected="@(ViewBag.CuentaId == c.Id)">@c.Codigo - @c.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Origen</label>
                    <select name="tipoOrigen" class="form-select form-select-sm">
                        <option value="">Todos los Orígenes</option>
                        <option value="Venta" selected="@(ViewBag.TipoOrigen == "Venta")">Ventas</option>
                        <option value="Compra" selected="@(ViewBag.TipoOrigen == "Compra")">Compras</option>
                        <option value="Gasto" selected="@(ViewBag.TipoOrigen == "Gasto")">Gastos</option>
                        <option value="Apertura" selected="@(ViewBag.TipoOrigen == "Apertura")">Apertura</option>
                        <option value="Manual" selected="@(ViewBag.TipoOrigen == "Manual")">Manual</option>
                        <option value="Demostracion" selected="@(ViewBag.TipoOrigen == "Demostracion")">Demostración</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Desde</label>
                    <input type="date" name="desde" class="form-control form-control-sm" value="@ViewBag.Desde" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Hasta</label>
                    <input type="date" name="hasta" class="form-control form-control-sm" value="@ViewBag.Hasta" />
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100" title="Filtrar"><i class="bi bi-filter"></i></button>
                    <a asp-action="Asientos" class="btn btn-outline-secondary btn-sm" title="Limpiar"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista de Asientos -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center text-muted bg-white">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
            <h5>No hay asientos contables registrados para este período o filtro.</h5>
        </div>
    }
    @foreach (var asiento in Model)
    {
        <div class="card border-0 shadow-sm mb-3 @(asiento.Anulado ? "border-start border-danger border-4 opacity-75" : "border-start border-primary border-4")">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold font-monospace fs-6">@asiento.NumeroAsiento</span>
                    <span class="badge bg-secondary">@asiento.TipoOrigen</span>
                    @if (asiento.Anulado)
                    {
                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>ANULADO</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Equilibrado</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-muted small">
                        <i class="bi bi-calendar3 me-1"></i> @asiento.Fecha.ToString("dd/MM/yyyy") |
                        <i class="bi bi-person me-1"></i> @(asiento.CreadoPor ?? "Sistema")
                    </div>
                    @if (!asiento.Anulado)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                onclick="abrirModalAnular(@asiento.Id, '@asiento.NumeroAsiento')" title="Anular asiento">
                            <i class="bi bi-trash3 me-1"></i> Anular
                        </button>
                    }
                </div>
            </div>
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <p class="mb-0 text-dark fw-bold">@asiento.Concepto</p>
                    @if (asiento.Anulado)
                    {
                        <div class="badge bg-danger-subtle text-danger p-2 text-start small">
                            <strong>Motivo Anulación:</strong> @asiento.MotivoAnulacion <br />
                            <small class="text-muted">Fecha: @(asiento.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</small>
                        </div>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-muted">
                                <th style="width: 140px;">Código</th>
                                <th>Cuenta Contable</th>
                                <th>Referencia / Detalle</th>
                                <th class="text-end" style="width: 140px;">Debe (C$)</th>
                                <th class="text-end" style="width: 140px;">Haber (C$)</th>
                                <th style="width: 80px;" class="text-center">Mayor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in asiento.Detalles)
                            {
                                <tr>
                                    <td class="font-monospace small fw-bold">@linea.CuentaContable?.Codigo</td>
                                    <td>@linea.CuentaContable?.Nombre</td>
                                    <td class="small text-muted">@linea.Descripcion</td>
                                    <td class="text-end fw-bold font-monospace @(linea.Debe > 0 ? "text-primary" : "text-muted")">
                                        @(linea.Debe > 0 ? $"C$ {linea.Debe:N2}" : "-")
                                    </td>
                                    <td class="text-end fw-bold font-monospace @(linea.Haber > 0 ? "text-success" : "text-muted")">
                                        @(linea.Haber > 0 ? $"C$ {linea.Haber:N2}" : "-")
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="CuentaT" asp-route-id="@linea.CuentaContableId" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Ver en Cuenta T">
                                            <i class="bi bi-layout-split"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light small fw-bold">
                            <tr>
                                <td colspan="3" class="text-end">Totales del Asiento:</td>
                                <td class="text-end text-primary font-monospace">C$ @asiento.Detalles.Sum(d => d.Debe).ToString("N2")</td>
                                <td class="text-end text-success font-monospace">C$ @asiento.Detalles.Sum(d => d.Haber).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal para Anular Asiento -->
<div class="modal fade" id="modalAnularAsiento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="AnularAsiento" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="anularAsientoId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Anular Asiento Contable
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p>
                        ¿Estás seguro de anular el asiento <strong id="lblNumeroAsiento" class="font-monospace"></strong>?
                    </p>
                    <div class="alert alert-warning small">
                        <i class="bi bi-info-circle me-1"></i>
                        El asiento no se borrará de SQL Server para preservar la trazabilidad contable y auditoría; quedará registrado como <strong>ANULADO</strong> y se descontará del balance y de las Cuentas T.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo o Justificación de la Anulación <span class="text-danger">*</span></label>
                        <textarea name="motivo" class="form-control" rows="3" placeholder="Ej. Error en imputación contable / Asiento duplicado..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-bold">Confirmar Anulación</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function abrirModalAnular(id, numero) {
        document.getElementById('anularAsientoId').value = id;
        document.getElementById('lblNumeroAsiento').innerText = numero;
        new bootstrap.Modal(document.getElementById('modalAnularAsiento')).show();
    }
</script>
}
