@model PizzeriaContable.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Panel de Control - Say Cheese Pizza";
}

<div class="container-fluid px-0">
    <!-- Say Cheese Hero Welcome & Filter Banner -->
    <div class="brick-hero-banner mb-4">
        <div class="brick-hero-content d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle overflow-hidden border border-2 border-warning shadow d-none d-sm-block flex-shrink-0" style="width: 64px; height: 64px; background: #FFF3DE;">
                    <img src="~/images/say-cheese-chef.jpg" alt="Chef Say Cheese" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/pizza-slice.svg';" />
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="h3 mb-0 fw-bold text-white font-brand">Panel de Control &bull; Say Cheese</h1>
                        <span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-1 small">En Vivo</span>
                    </div>
                    <p class="text-white-50 small mb-0">Métricas contables, facturación del horno y control de insumos en tiempo real.</p>
                </div>
            </div>

            <!-- Date Filter Form -->
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2 bg-white p-2 rounded-3 shadow-sm border" style="border-color: var(--sc-border-warm) !important;">
                <span class="small fw-bold text-dark"><i class="bi bi-calendar-range text-warning me-1"></i> Período:</span>
                <input type="date" name="desde" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width: auto;" />
                <span class="text-muted small">al</span>
                <input type="date" name="hasta" value="@Model.FechaFin.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width: auto;" />
                <button type="submit" class="btn btn-sm btn-saycheese-primary">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
            </form>
        </div>
    </div>

    @if (Model.BaseDatosVacia)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4 rounded-3 p-3" role="alert" style="background-color: var(--sc-cream); border-left: 5px solid var(--sc-orange) !important;">
            <i class="bi bi-fire fs-2 me-3 text-warning"></i>
            <div>
                <h5 class="alert-heading mb-1 fw-bold text-dark font-brand">¡Hornos listos para operar!</h5>
                <p class="mb-0 small text-dark">No se han registrado operaciones en este período. Comienza abriendo un turno en el <a asp-controller="Caja" asp-action="Index" class="fw-bold text-dark text-decoration-underline">Control de Caja</a> o registrando pedidos en el <a asp-controller="Ventas" asp-action="Pos" class="fw-bold text-dark text-decoration-underline">Punto de Venta (POS)</a>.</p>
            </div>
        </div>
    }

    <!-- Stat Cards Row con paleta cálida Say Cheese -->
    <div class="row g-3 mb-4">
        <!-- Ventas Hoy -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-success h-100 d-flex align-items-center">
                <div class="stat-icon bg-sc-green-subtle me-3">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <div>
                    <span class="text-muted small fw-bold text-uppercase">Ventas de Hoy</span>
                    <h3 class="h4 mb-0 fw-bold text-dark">@Model.VentasHoy.ToString("C2")</h3>
                    <small class="text-muted font-numeric">@Model.CantidadVentasHoy tickets cobrados</small>
                </div>
            </div>
        </div>

        <!-- Ventas Período -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-primary h-100 d-flex align-items-center">
                <div class="stat-icon bg-sc-orange-subtle me-3">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div>
                    <span class="text-muted small fw-bold text-uppercase">Ventas del Período</span>
                    <h3 class="h4 mb-0 fw-bold text-dark">@Model.VentasMes.ToString("C2")</h3>
                    <small class="text-muted">Facturación acumulada</small>
                </div>
            </div>
        </div>

        <!-- Compras Período -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-warning h-100 d-flex align-items-center">
                <div class="stat-icon bg-sc-yellow-subtle me-3">
                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <span class="text-muted small fw-bold text-uppercase">Compras de Insumos</span>
                    <h3 class="h4 mb-0 fw-bold text-dark">@Model.ComprasPeriodo.ToString("C2")</h3>
                    <small class="text-muted">Queso, harina y carnes</small>
                </div>
            </div>
        </div>

        <!-- Gastos Operativos -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-danger h-100 d-flex align-items-center">
                <div class="stat-icon bg-sc-brick-subtle me-3">
                    <i class="bi bi-lightning-charge"></i>
                </div>
                <div>
                    <span class="text-muted small fw-bold text-uppercase">Gastos Operativos</span>
                    <h3 class="h4 mb-0 fw-bold text-dark">@Model.GastosPeriodo.ToString("C2")</h3>
                    <small class="text-muted">Gas, servicios y local</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Performance and Cash in Drawer -->
    <div class="row g-3 mb-4">
        <!-- Margen y Resultado Estimado -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-dark">
                        <i class="bi bi-graph-up-arrow text-warning me-2"></i> Rendimiento Económico del Horno
                    </h2>
                    <span class="badge rounded-pill bg-light text-dark border px-3 py-1 font-numeric" style="border-color: var(--sc-border-warm) !important;">
                        @Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 text-center mb-4">
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-3" style="background-color: var(--sc-cream-light); border: 1px solid var(--sc-border-warm);">
                                <span class="text-muted small fw-bold d-block mb-1">Ingresos Totales</span>
                                <div class="h5 fw-bold text-dark mb-0 font-numeric">@Model.VentasMes.ToString("C2")</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-3" style="background-color: var(--sc-cream-light); border: 1px solid var(--sc-border-warm);">
                                <span class="text-muted small fw-bold d-block mb-1">Costo de Ventas</span>
                                <div class="h5 fw-bold text-secondary mb-0 font-numeric">@Model.CostoVentasPeriodo.ToString("C2")</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-3" style="background-color: #FEF3E8; border: 1px solid #F5CBA7;">
                                <span class="small fw-bold d-block mb-1" style="color: var(--sc-orange);">Margen Bruto</span>
                                <div class="h5 fw-bold text-dark mb-0 font-numeric">@Model.MargenBruto.ToString("C2")</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-3" style="background-color: @(Model.ResultadoEstimado >= 0 ? "#E8F5E9" : "#FDEDEC"); border: 1px solid @(Model.ResultadoEstimado >= 0 ? "#A9DFBF" : "#F5B7B1");">
                                <span class="small fw-bold d-block mb-1" style="color: @(Model.ResultadoEstimado >= 0 ? "var(--sc-green)" : "var(--sc-red)");">Resultado Neto</span>
                                <div class="h5 fw-bold @(Model.ResultadoEstimado >= 0 ? "text-success" : "text-danger") mb-0 font-numeric">
                                    @Model.ResultadoEstimado.ToString("C2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 small text-muted d-flex align-items-start gap-2" style="background-color: var(--sc-cream); border: 1px dashed var(--sc-orange);">
                        <i class="bi bi-info-circle-fill text-warning fs-5 flex-shrink-0"></i>
                        <span>
                            El <strong>Margen Bruto</strong> calcula la venta neta menos el consumo de masa, queso mozzarella y toppings de las recetas. El <strong>Resultado Neto</strong> descuenta los gastos fijos del local.
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estado de Caja & Obligaciones -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-wallet2 text-success me-2"></i> Gaveta de Caja & Saldos</h2>
                    @if (Model.HayCajaAbierta)
                    {
                        <span class="badge bg-success rounded-pill px-2 py-1"><i class="bi bi-check-circle me-1"></i> Abierta</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill px-2 py-1"><i class="bi bi-lock me-1"></i> Cerrada</span>
                    }
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="p-3 rounded-3 mb-3" style="background: linear-gradient(135deg, var(--sc-cream-light) 0%, var(--sc-cream) 100%); border: 1px solid var(--sc-border-warm);">
                            <span class="text-muted small fw-bold d-block mb-1">Efectivo Físico Disponible</span>
                            <span class="h3 fw-bold mb-0 text-success font-numeric d-block">@Model.EfectivoEnCajaActual.ToString("C2")</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light mb-3">
                            <span class="text-muted small fw-semibold">Cuentas por Pagar (Proveedores):</span>
                            <span class="fw-bold text-danger font-numeric">@Model.CuentasPorPagarPendientes.ToString("C2")</span>
                        </div>
                    </div>

                    <div class="pt-2">
                        <a asp-controller="Ventas" asp-action="Pos" class="btn btn-warning w-100 fw-bold py-2 shadow-sm mb-2 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-cart-plus-fill fs-5"></i> Abrir Punto de Venta (POS)
                        </a>
                        <a asp-controller="Caja" asp-action="Index" class="btn btn-outline-secondary w-100 btn-sm py-2">
                            <i class="bi bi-cash-stack me-1"></i> Administrar Turno de Caja
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Row: Low Stock Alerts and Recent Sales -->
    <div class="row g-3">
        <!-- Low Stock Alerts -->
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-dark">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Insumos con Stock Bajo
                    </h2>
                    <a asp-controller="Ingredientes" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Ver catálogo</a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.IngredientesStockBajo.Any())
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                            <span class="fw-semibold">¡Despensa al 100%! Todos los ingredientes tienen existencia suficiente.</span>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var ing in Model.IngredientesStockBajo)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-box-seam text-danger fs-5"></i>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@ing.Nombre</span>
                                            <span class="text-muted small">Mínimo requerido: @ing.StockMinimo.ToString("0.##") @ing.UnidadMedida</span>
                                        </div>
                                    </div>
                                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle fs-6 font-numeric px-3 py-1">
                                        @ing.StockActual.ToString("0.##") @ing.UnidadMedida
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Sales -->
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-dark">
                        <i class="bi bi-clock-history text-primary me-2"></i> Últimos Tickets de Mostrador
                    </h2>
                    <a asp-controller="Ventas" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Historial completo</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Fecha y Hora</th>
                                <th>Cliente</th>
                                <th>Pago</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.UltimasVentas.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-receipt fs-2 d-block mb-1 text-secondary"></i>
                                        No hay tickets de venta registrados recientemente.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var v in Model.UltimasVentas)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold">
                                            <a asp-controller="Ventas" asp-action="Details" asp-route-id="@v.Id" class="text-decoration-none text-dark d-flex align-items-center gap-1">
                                                <i class="bi bi-receipt text-warning"></i> @v.NumeroComprobante
                                            </a>
                                        </td>
                                        <td class="text-muted font-numeric">@v.Fecha.ToString("dd/MM/yy HH:mm")</td>
                                        <td>@(v.ClienteNombre ?? "Cliente General")</td>
                                        <td><span class="badge bg-light text-dark border font-numeric">@v.MetodoPago</span></td>
                                        <td class="text-end fw-bold text-dark font-numeric">@v.Total.ToString("C2")</td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill @(v.Estado == "Completada" ? "bg-success" : "bg-danger") px-2 py-1">
                                                @v.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
