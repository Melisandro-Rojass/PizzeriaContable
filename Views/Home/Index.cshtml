@model PizzeriaContable.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container-fluid">
    <!-- Header with Date Filters -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 text-gray-800 fw-bold">Panel de Control Financiero y Operativo</h1>
            <p class="text-muted small mb-0">Métricas en tiempo real a partir de registros contables y movimientos reales.</p>
        </div>
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 bg-white p-2 rounded shadow-sm border">
            <span class="text-muted small fw-semibold"><i class="bi bi-filter"></i> Período:</span>
            <input type="date" name="desde" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <span class="text-muted small">a</span>
            <input type="date" name="hasta" value="@Model.FechaFin.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
        </form>
    </div>

    @if (Model.BaseDatosVacia)
    {
        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-info-circle-fill fs-3 me-3 text-info"></i>
            <div>
                <h5 class="alert-heading mb-1 fw-bold">Sistema Listo para Operar</h5>
                <p class="mb-0 small">No se han registrado operaciones para este período. Comienza abriendo un turno en el <a asp-controller="Caja" asp-action="Index" class="fw-bold text-decoration-none">Control de Caja</a> o registrando ventas en el <a asp-controller="Ventas" asp-action="Pos" class="fw-bold text-decoration-none">Punto de Venta (POS)</a>.</p>
            </div>
        </div>
    }

    <!-- Stat Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Ventas Hoy -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card d-flex align-items-center">
                <div class="stat-icon bg-success-subtle text-success me-3">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Ventas de Hoy</span>
                    <h3 class="h4 mb-0 fw-bold text-dark">@Model.VentasHoy.ToString("C2")</h3>
                    <small class="text-muted">@Model.CantidadVentasHoy tickets cobrados</small>
                </div>
            </div>
        </div>

        <!-- Ventas Período -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card d-flex align-items-center">
                <div class="stat-icon bg-primary-subtle text-primary me-3">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Ventas del Período</span>
                    <h3 class="h4 mb-0 fw-bold text-dark">@Model.VentasMes.ToString("C2")</h3>
                    <small class="text-muted">Facturación acumulada</small>
                </div>
            </div>
        </div>

        <!-- Compras Período -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card d-flex align-items-center">
                <div class="stat-icon bg-warning-subtle text-warning me-3">
                    <i class="bi bi-bag-check"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Compras de Ingredientes</span>
                    <h3 class="h4 mb-0 fw-bold text-dark">@Model.ComprasPeriodo.ToString("C2")</h3>
                    <small class="text-muted">Insumos y mercancías</small>
                </div>
            </div>
        </div>

        <!-- Gastos Operativos -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card d-flex align-items-center">
                <div class="stat-icon bg-danger-subtle text-danger me-3">
                    <i class="bi bi-lightning-charge"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Gastos Operativos</span>
                    <h3 class="h4 mb-0 fw-bold text-dark">@Model.GastosPeriodo.ToString("C2")</h3>
                    <small class="text-muted">Servicios, local, etc.</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Performance and Cash in Drawer -->
    <div class="row g-3 mb-4">
        <!-- Margen y Resultado Estimado -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-line text-primary me-2"></i> Rendimiento Económico del Período</h2>
                    <span class="badge bg-light text-dark border">
                        @Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <div class="card-body">
                    <div class="row g-3 text-center mb-3">
                        <div class="col-md-3">
                            <span class="text-muted small">Ingresos Totales</span>
                            <div class="h5 fw-bold text-dark">@Model.VentasMes.ToString("C2")</div>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small">Costo de Ventas</span>
                            <div class="h5 fw-bold text-secondary">@Model.CostoVentasPeriodo.ToString("C2")</div>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small">Margen Bruto</span>
                            <div class="h5 fw-bold text-primary">@Model.MargenBruto.ToString("C2")</div>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small">Resultado Operativo</span>
                            <div class="h5 fw-bold @(Model.ResultadoEstimado >= 0 ? "text-success" : "text-danger")">
                                @Model.ResultadoEstimado.ToString("C2")
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded small text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        El <strong>Margen Bruto</strong> refleja la diferencia entre las ventas netas y el costo real de los ingredientes consumidos según las recetas. El <strong>Resultado Operativo</strong> descuenta los gastos fijos y variables del período.
                    </div>
                </div>
            </div>
        </div>

        <!-- Estado de Caja & Obligaciones -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-wallet2 text-success me-2"></i> Estado de Caja & Saldos</h2>
                </div>
                <div class="card-body">
                    <div class="mb-3 pb-3 border-bottom">
                        <span class="text-muted small d-block mb-1">Efectivo Físico en Gaveta</span>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="h4 fw-bold mb-0 text-success">@Model.EfectivoEnCajaActual.ToString("C2")</span>
                            @if (Model.HayCajaAbierta)
                            {
                                <span class="badge bg-success">Caja Abierta</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Caja Cerrada</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Cuentas por Pagar (Proveedores):</span>
                        <span class="fw-bold text-danger">@Model.CuentasPorPagarPendientes.ToString("C2")</span>
                    </div>

                    <div class="pt-3">
                        <a asp-controller="Ventas" asp-action="Pos" class="btn btn-warning w-100 fw-bold text-dark mb-2">
                            <i class="bi bi-cart-plus me-1"></i> Ir al Punto de Venta (POS)
                        </a>
                        <a asp-controller="Caja" asp-action="Index" class="btn btn-outline-secondary w-100 btn-sm">
                            <i class="bi bi-cash-stack me-1"></i> Administrar Turno de Caja
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Row: Low Stock Alerts and Recent Sales -->
    <div class="row g-3">
        <!-- Low Stock Alerts -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Stock Bajo de Ingredientes</h2>
                    <a asp-controller="Ingredientes" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Ver todos</a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.IngredientesStockBajo.Any())
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                            Todos los ingredientes tienen existencia suficiente.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var ing in Model.IngredientesStockBajo)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <div>
                                        <span class="fw-semibold text-dark">@ing.Nombre</span>
                                        <div class="text-muted small">Mínimo: @ing.StockMinimo.ToString("0.##") @ing.UnidadMedida</div>
                                    </div>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6">
                                        @ing.StockActual.ToString("0.##") @ing.UnidadMedida
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Sales -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-clock-history text-primary me-2"></i> Últimas Ventas Registradas</h2>
                    <a asp-controller="Ventas" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Ver historial completo</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Ticket</th>
                                <th>Fecha y Hora</th>
                                <th>Cliente</th>
                                <th>Método</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.UltimasVentas.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No hay ventas registradas recientemente.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var v in Model.UltimasVentas)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold">
                                            <a asp-controller="Ventas" asp-action="Details" asp-route-id="@v.Id" class="text-decoration-none text-dark">
                                                @v.NumeroComprobante
                                            </a>
                                        </td>
                                        <td>@v.Fecha.ToString("dd/MM/yy HH:mm")</td>
                                        <td>@(v.ClienteNombre ?? "General")</td>
                                        <td><span class="badge bg-light text-dark border">@v.MetodoPago</span></td>
                                        <td class="text-end fw-bold text-dark">@v.Total.ToString("C2")</td>
                                        <td class="text-center">
                                            <span class="badge @(v.Estado == "Completada" ? "bg-success" : "bg-danger")">
                                                @v.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
