<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pizzería Contable</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Google Fonts: Fredoka & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="sidebarMenu">
            <div class="sidebar-brand-wrapper">
                <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                    <img src="~/images/say-cheese-logo.svg" alt="Say Cheese Pizza" class="sidebar-logo-img" />
                    <div class="sidebar-brand-text">
                        <span class="sidebar-brand-title">SAY <span>CHEESE</span></span>
                        <span class="sidebar-brand-sub">Control &amp; POS</span>
                    </div>
                </a>
            </div>

            <ul class="sidebar-nav">
                <!-- Principal: Accesible por todos los usuarios autenticados -->
                <li class="nav-section-title">Principal</li>
                <li>
                    <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Panel de Control</span>
                    </a>
                </li>

                @if (User.IsInRole("Administrador") || User.IsInRole("Cajero"))
                {
                    <li class="my-1">
                        <a asp-controller="Ventas" asp-action="Pos" class="nav-link nav-badge-pos @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" && ViewContext.RouteData.Values["action"]?.ToString() == "Pos" ? "active" : "")">
                            <i class="bi bi-cart-plus-fill text-warning"></i>
                            <span class="fw-bold">Punto de Venta (POS)</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Cajero") || User.IsInRole("Contador") || User.IsInRole("Contabilidad"))
                {
                    <li>
                        <a asp-controller="Caja" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Caja" ? "active" : "")">
                            <i class="bi bi-cash-stack"></i>
                            <span>Control de Caja</span>
                        </a>
                    </li>
                }

                <!-- Catálogo y Menú -->
                @if (User.IsInRole("Administrador") || User.IsInRole("Inventario") || User.IsInRole("EncargadoInventario") || User.IsInRole("Contador") || User.IsInRole("Contabilidad") || User.IsInRole("Cajero") || User.IsInRole("Consulta"))
                {
                    <li class="nav-section-title">Catálogo y Menú</li>
                    <li>
                        <a asp-controller="Productos" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Productos" ? "active" : "")">
                            <i class="bi bi-card-checklist"></i>
                            <span>Productos</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Inventario") || User.IsInRole("EncargadoInventario"))
                {
                    <li>
                        <a asp-controller="Categorias" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categorias" ? "active" : "")">
                            <i class="bi bi-tags"></i>
                            <span>Categorías</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Ingredientes" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ingredientes" ? "active" : "")">
                            <i class="bi bi-boxes"></i>
                            <span>Ingredientes / Stock</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Recetas" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Recetas" ? "active" : "")">
                            <i class="bi bi-journal-bookmark"></i>
                            <span>Recetas y Costeo</span>
                        </a>
                    </li>
                }

                <!-- Operaciones -->
                @if (User.IsInRole("Administrador") || User.IsInRole("Cajero") || User.IsInRole("Contador") || User.IsInRole("Contabilidad") || User.IsInRole("Inventario") || User.IsInRole("EncargadoInventario"))
                {
                    <li class="nav-section-title">Operaciones</li>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Cajero") || User.IsInRole("Contador") || User.IsInRole("Contabilidad"))
                    {
                        <li>
                            <a asp-controller="Ventas" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" && ViewContext.RouteData.Values["action"]?.ToString() != "Pos" ? "active" : "")">
                                <i class="bi bi-receipt"></i>
                                <span>Historial de Ventas</span>
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Administrador") || User.IsInRole("Inventario") || User.IsInRole("EncargadoInventario") || User.IsInRole("Contador") || User.IsInRole("Contabilidad"))
                    {
                        <li>
                            <a asp-controller="Compras" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Compras" ? "active" : "")">
                                <i class="bi bi-bag-check"></i>
                                <span>Compras a Proveedores</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Proveedores" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedores" ? "active" : "")">
                                <i class="bi bi-truck"></i>
                                <span>Proveedores</span>
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Administrador") || User.IsInRole("Contador") || User.IsInRole("Contabilidad"))
                    {
                        <li>
                            <a asp-controller="Gastos" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gastos" ? "active" : "")">
                                <i class="bi bi-cash-coin"></i>
                                <span>Gastos Operativos</span>
                            </a>
                        </li>
                    }
                }

                <!-- Contabilidad: Administrador y Contabilidad -->
                @if (User.IsInRole("Administrador") || User.IsInRole("Contador") || User.IsInRole("Contabilidad"))
                {
                    <li class="nav-section-title">Contabilidad</li>
                    <li>
                        <a asp-controller="Contabilidad" asp-action="CuentasT" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CuentasT" || ViewContext.RouteData.Values["action"]?.ToString() == "CuentaT" ? "active" : "")">
                            <i class="bi bi-layout-split text-warning"></i>
                            <span class="fw-bold">Cuentas T (Mayor)</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Contabilidad" asp-action="Cuentas" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Cuentas" ? "active" : "")">
                            <i class="bi bi-diagram-3"></i>
                            <span>Catálogo de Cuentas</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Contabilidad" asp-action="Asientos" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Asientos" ? "active" : "")">
                            <i class="bi bi-journal-text"></i>
                            <span>Libro Diario / Asientos</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Contabilidad" asp-action="Apertura" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Apertura" ? "active" : "")">
                            <i class="bi bi-door-open"></i>
                            <span>Apertura Contable</span>
                        </a>
                    </li>
                }

                <!-- Informes -->
                @if (User.IsInRole("Administrador") || User.IsInRole("Contador") || User.IsInRole("Contabilidad") || User.IsInRole("Consulta"))
                {
                    <li class="nav-section-title">Informes</li>
                    <li>
                        <a asp-controller="Reportes" asp-action="EstadoResultados" class="nav-link">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Estado de Resultados</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Reportes" asp-action="BalanceGeneral" class="nav-link">
                            <i class="bi bi-bank"></i>
                            <span>Balance General</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Reportes" asp-action="BalanceComprobacion" class="nav-link">
                            <i class="bi bi-clipboard-data"></i>
                            <span>Balance Comprobación</span>
                        </a>
                    </li>
                }

                <!-- Sistema: Exclusivo Administrador -->
                @if (User.IsInRole("Administrador"))
                {
                    <li class="nav-section-title">Sistema</li>
                    <li>
                        <a asp-controller="Usuarios" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")">
                            <i class="bi bi-people-fill text-warning"></i>
                            <span class="fw-bold">Empleados y Roles</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Configuracion" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Configuracion" ? "active" : "")">
                            <i class="bi bi-gear"></i>
                            <span>Configuración Empresa</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="app-main">
            <!-- Topbar Header -->
            <header class="app-topbar shadow-sm">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-secondary d-lg-none me-2" type="button" onclick="document.getElementById('sidebarMenu').classList.toggle('show')">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="text-muted small d-none d-md-inline">
                        <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-NI"))
                    </span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (User.IsInRole("Administrador") || User.IsInRole("Cajero"))
                    {
                        <a asp-controller="Caja" asp-action="Index" class="text-decoration-none">
                            <span class="badge bg-light text-dark border p-2 shadow-sm rounded-pill d-flex align-items-center gap-1" style="border-color: var(--sc-border-warm) !important;">
                                <i class="bi bi-wallet2 text-success me-1"></i> <span>Turno de Caja</span>
                            </span>
                        </a>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        string userRole = User.IsInRole("Administrador") ? "Administrador" :
                                         (User.IsInRole("Contabilidad") || User.IsInRole("Contador")) ? "Contabilidad" :
                                         User.IsInRole("Cajero") ? "Cajero" :
                                         (User.IsInRole("Inventario") || User.IsInRole("EncargadoInventario")) ? "Inventario" :
                                         User.IsInRole("Consulta") ? "Consulta" : "Empleado";

                        string roleBadgeStyle = userRole switch
                        {
                            "Administrador" => "background-color: var(--sc-brick-red); color: #fff;",
                            "Contabilidad" => "background-color: var(--sc-green); color: #fff;",
                            "Cajero" => "background-color: var(--sc-orange); color: #fff;",
                            "Inventario" => "background-color: var(--sc-yellow); color: var(--sc-crust-dark); font-weight: 700;",
                            "Consulta" => "background-color: #64748b; color: #fff;",
                            _ => "background-color: #64748b; color: #fff;"
                        };

                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1 bg-white shadow-sm" style="border-color: var(--sc-border-warm);" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="rounded-circle d-flex align-items-center justify-content-center overflow-hidden border" style="width: 32px; height: 32px; background: var(--sc-cream); border-color: var(--sc-orange) !important;">
                                    <img src="~/images/say-cheese-chef.jpg" alt="Chef" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                                    <span style="display: none; font-weight: 800; font-size: 0.85rem; color: var(--sc-brick-red);">@(User.Identity.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "U")</span>
                                </div>
                                <span class="fw-bold text-dark">@(User.Identity.Name ?? "Usuario")</span>
                                <span class="badge rounded-pill ms-1" style="@roleBadgeStyle">@userRole</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border-radius: 12px; border-color: var(--sc-border-warm);">
                                <li class="px-3 py-2 small text-muted border-bottom bg-light rounded-top">
                                    Conectado como <strong class="text-dark">@(User.Identity.Name)</strong>
                                </li>
                                <li><a class="dropdown-item mt-1 py-2" asp-controller="Usuarios" asp-action="Perfil"><i class="bi bi-person me-2 text-warning"></i>Mi Perfil</a></li>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <li><a class="dropdown-item py-2" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people me-2 text-primary"></i>Gestión de Empleados</a></li>
                                }
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-controller="Usuarios" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Usuarios" asp-action="Login" class="btn btn-sm btn-saycheese-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar
                        </a>
                    }
                </div>
            </header>

            <!-- Page Body -->
            <main class="content-body">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 px-4 text-muted small text-center text-md-start" style="border-color: var(--sc-border-warm) !important;">
                <div class="container-fluid d-flex justify-content-between align-items-center flex-column flex-md-row gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <img src="~/images/say-cheese-logo.svg" alt="Say Cheese" style="height: 22px; width: auto;" />
                        <span>&copy; @DateTime.Now.Year - <strong>Say Cheese Pizza</strong> &bull; Sistema Contable y POS</span>
                    </div>
                    <span class="text-secondary">Moneda: Córdobas (NIO C$) &bull; Hornos Encendidos Managua</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
