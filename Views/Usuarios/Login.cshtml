@model PizzeriaContable.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - Say Cheese Pizza";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Say Cheese Pizzería Contable</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Google Fonts: Fredoka (Marca Say Cheese) & Plus Jakarta Sans (Texto y Formularios) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Hoja de Estilos Específica del Login Say Cheese -->
    <link rel="stylesheet" href="/css/login.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-master-container">
        <div class="login-split-card">
            
            <!-- PANEL IZQUIERDO: IDENTIDAD DE MARCA SAY CHEESE -->
            <aside class="brand-showcase-panel" aria-label="Identidad de Marca Say Cheese">
                <div class="brand-showcase-content">
                    <div class="brand-badge-pill">
                        <i class="bi bi-patch-check-fill"></i>
                        <span>Pizzería Artesanal &bull; Managua, Nicaragua</span>
                    </div>

                    <div class="brand-logo-container">
                        <img src="/images/say-cheese-logo.svg" alt="Say Cheese Pizza" class="brand-logo-img" />
                    </div>

                    <!-- Chef Caricaturesco Oficial Say Cheese -->
                    <div class="chef-hero-frame" title="Chef Maestro Say Cheese">
                        <img src="/images/say-cheese-chef.jpg" alt="Chef Maestro Say Cheese" onerror="this.src='/images/pizza-slice.svg';" />
                    </div>

                    <div class="brand-tagline-quote">
                        <h2>«Buen sabor, <span class="text-cheese">grandes momentos»</span></h2>
                        <p>Gestión comercial, operativa y financiera centralizada con rigor contable en Córdobas (C$).</p>
                    </div>

                    <!-- Pilares Funcionales del Sistema -->
                    <div class="brand-pillars-list">
                        <div class="pillar-item">
                            <div class="pillar-icon-box">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </div>
                            <div class="pillar-item-text">
                                <span class="pillar-item-title">Punto de Venta POS</span>
                                <span class="pillar-item-desc">Facturación rápida, mesas y órdenes para llevar</span>
                            </div>
                        </div>

                        <div class="pillar-item">
                            <div class="pillar-icon-box">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>
                            <div class="pillar-item-text">
                                <span class="pillar-item-title">Inventario por Receta</span>
                                <span class="pillar-item-desc">Deducción automática y control de mermas</span>
                            </div>
                        </div>

                        <div class="pillar-item">
                            <div class="pillar-icon-box">
                                <i class="bi bi-calculator-fill"></i>
                            </div>
                            <div class="pillar-item-text">
                                <span class="pillar-item-title">Contabilidad y Cuentas T</span>
                                <span class="pillar-item-desc">Partida doble, libro diario y arqueo de caja</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="brand-showcase-footer">
                    <span><i class="bi bi-fire me-1"></i> Horneado tradicional</span>
                    <span><i class="bi bi-shield-check me-1"></i> Control de acceso seguro</span>
                </div>
            </aside>

            <!-- PANEL DERECHO: FORMULARIO DE ACCESO AUTENTICADO -->
            <main class="login-form-panel">
                <div class="form-header-area">
                    <span class="form-pretitle">
                        <i class="bi bi-shield-lock-fill"></i> Sistema Contable y Operativo
                    </span>
                    <h1 class="form-main-title">Iniciar Sesión</h1>
                    <p class="form-subtitle">
                        Ingrese sus credenciales de colaborador para acceder al panel de administración y operaciones de la pizzería.
                    </p>
                </div>

                <!-- Resumen de Errores de Autenticación / Bloqueo -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="custom-auth-alert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div class="custom-auth-alert-body">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    </div>
                }

                <!-- Formulario Seguro con Anti-Forgery Token -->
                <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Campo Usuario o Correo -->
                    <div class="mb-3">
                        <label asp-for="UserNameOrEmail" class="form-label-custom">Usuario o Correo Electrónico</label>
                        <div class="custom-input-group">
                            <div class="input-icon-cell" aria-hidden="true">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <input asp-for="UserNameOrEmail" 
                                   class="custom-form-input" 
                                   placeholder="Ej. admin@pizzeria.local o usuario" 
                                   autofocus 
                                   required 
                                   autocomplete="username" 
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="UserNameOrEmail" class="field-error-msg"></span>
                    </div>

                    <!-- Campo Contraseña con Toggle de Visibilidad -->
                    <div class="mb-2">
                        <label asp-for="Password" class="form-label-custom">Contraseña de Acceso</label>
                        <div class="custom-input-group">
                            <div class="input-icon-cell" aria-hidden="true">
                                <i class="bi bi-key-fill"></i>
                            </div>
                            <input asp-for="Password" 
                                   id="passwordInput" 
                                   type="password"
                                   class="custom-form-input" 
                                   placeholder="••••••••••••" 
                                   required 
                                   autocomplete="current-password" 
                                   aria-required="true" />
                            <button type="button" 
                                    class="btn-toggle-eye" 
                                    id="btnTogglePassword" 
                                    title="Mostrar u ocultar contraseña" 
                                    aria-label="Mostrar u ocultar contraseña" 
                                    tabindex="-1">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error-msg"></span>
                    </div>

                    <!-- Opciones de Sesión y Verificación de Seguridad -->
                    <div class="form-utility-row">
                        <label class="custom-checkbox-label" for="rememberMeCheck">
                            <input asp-for="RememberMe" class="custom-checkbox-input" id="rememberMeCheck" />
                            <span>Recordar sesión en este equipo</span>
                        </label>

                        <div class="security-badge" title="Canal seguro mediante TLS/HTTPS">
                            <i class="bi bi-shield-check"></i>
                            <span>Cifrado Identity</span>
                        </div>
                    </div>

                    <!-- Botón Principal de Envío -->
                    <button type="submit" id="btnSubmit" class="btn-enter-system">
                        <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        <i class="bi bi-box-arrow-in-right fs-5" id="btnIcon"></i>
                        <span id="btnText">INGRESAR AL SISTEMA</span>
                    </button>
                </form>

                <!-- Pie del Formulario y Enlace de Soporte -->
                <div class="form-footer-area">
                    <p class="support-hint-text">
                        ¿Olvidó sus credenciales o necesita permisos de turno? Contacte a la <strong>Administración</strong>.
                    </p>
                    <p class="system-copyright-text">
                        &copy; @DateTime.Now.Year <strong>Say Cheese Pizza</strong> &bull; Sistema Contable y Punto de Venta &bull; Managua, Nicaragua (NIO C$)
                    </p>
                </div>
            </main>

        </div>

        <!-- Badges Promocionales Inferiores Inspirados en la Identidad Say Cheese -->
        <div class="login-bottom-strip">
            <div class="bottom-strip-badge">
                <i class="bi bi-fire"></i>
                <span>Pizzas Horneadas al Momento</span>
            </div>
            <div class="bottom-strip-badge">
                <i class="bi bi-check2-circle"></i>
                <span>Ingredientes de Calidad Superior</span>
            </div>
            <div class="bottom-strip-badge">
                <i class="bi bi-cash-stack"></i>
                <span>Cuentas Claras en Córdobas (C$)</span>
            </div>
        </div>
    </div>

    <!-- Scripts de Interacción Segura -->
    <script>
        // Alternar visibilidad de contraseña
        const btnToggle = document.getElementById('btnTogglePassword');
        const passInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('toggleIcon');

        if (btnToggle && passInput && toggleIcon) {
            btnToggle.addEventListener('click', function () {
                const isPassword = passInput.getAttribute('type') === 'password';
                passInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                btnToggle.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        }

        // Indicador de carga durante el envío del formulario
        const loginForm = document.getElementById('loginForm');
        const btnSubmit = document.getElementById('btnSubmit');
        const btnSpinner = document.getElementById('btnSpinner');
        const btnIcon = document.getElementById('btnIcon');
        const btnText = document.getElementById('btnText');

        if (loginForm && btnSubmit) {
            loginForm.addEventListener('submit', function (e) {
                // Validación HTML5 básica antes de activar spinner
                if (loginForm.checkValidity()) {
                    btnSubmit.setAttribute('disabled', 'disabled');
                    btnSpinner.classList.remove('d-none');
                    btnIcon.classList.add('d-none');
                    btnText.textContent = 'Verificando credenciales...';
                }
            });
        }
    </script>
</body>
</html>
