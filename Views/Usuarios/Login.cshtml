@model PizzeriaContable.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - PizzeriaContable";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - PizzeriaContable</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Google Fonts: Fredoka (Marca Say Cheese) & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Hoja de Estilos Específica del Login Say Cheese -->
    <link rel="stylesheet" href="/css/login.css" asp-append-version="true" />
</head>
<body class="cuerpo-acceso">
    <div class="contenedor-acceso">
        <div class="tarjeta-acceso shadow-lg">
            
            <!-- Encabezado de Marca Say Cheese -->
            <header class="encabezado-marca-acceso">
                <div class="circulo-chef" title="Chef Say Cheese">
                    <img src="/images/say-cheese-chef.jpg" alt="Chef Say Cheese" onerror="this.src='/images/pizza-slice.svg';" />
                </div>
                <div class="contenedor-logo-marca">
                    <img src="/images/say-cheese-logo.svg" alt="Say Cheese Pizza" class="logo-marca-acceso" />
                </div>
                <h1 class="titulo-marca-acceso">PizzeriaContable</h1>
                <p class="eslogan-marca-acceso">Gestión de tu negocio, en un solo lugar</p>
            </header>

            <!-- Formulario de Acceso -->
            <main class="cuerpo-formulario-acceso">
                <div class="intro-formulario-acceso">
                    <h2 class="titulo-formulario-acceso">Iniciar sesión</h2>
                    <p class="subtitulo-formulario-acceso">Ingresa tus credenciales para acceder al sistema</p>
                </div>

                <!-- Resumen de Errores de Autenticación / Bloqueo -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alerta-peligro-acceso" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div class="texto-alerta-acceso">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    </div>
                }

                <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Campo Usuario o Correo -->
                    <div class="grupo-campo-acceso">
                        <label asp-for="UserNameOrEmail" class="etiqueta-campo-acceso">Usuario o correo electrónico</label>
                        <div class="contenedor-entrada-acceso">
                            <span class="icono-entrada-acceso" aria-hidden="true">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <input asp-for="UserNameOrEmail" 
                                   class="entrada-campo-acceso" 
                                   placeholder="admin@pizzeria.local o usuario" 
                                   autofocus 
                                   required 
                                   autocomplete="username" 
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="UserNameOrEmail" class="error-campo-acceso"></span>
                    </div>

                    <!-- Campo Contraseña con Toggle de Visibilidad -->
                    <div class="grupo-campo-acceso">
                        <label asp-for="Password" class="etiqueta-campo-acceso">Contraseña</label>
                        <div class="contenedor-entrada-acceso">
                            <span class="icono-entrada-acceso" aria-hidden="true">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="Password" 
                                   id="passwordInput" 
                                   type="password"
                                   class="entrada-campo-acceso" 
                                   placeholder="••••••••" 
                                   required 
                                   autocomplete="current-password" 
                                   aria-required="true" />
                            <button type="button" 
                                    class="btn-ojo-acceso" 
                                    id="btnTogglePassword" 
                                    title="Mostrar u ocultar contraseña" 
                                    aria-label="Mostrar u ocultar contraseña" 
                                    tabindex="-1">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="error-campo-acceso"></span>
                    </div>

                    <!-- Fila de Utilidad: Recordar sesión y Cifrado -->
                    <div class="fila-opciones-acceso">
                        <label class="casilla-etiqueta-acceso" for="rememberMeCheck">
                            <input asp-for="RememberMe" class="casilla-entrada-acceso" id="rememberMeCheck" />
                            <span>Recordar sesión</span>
                        </label>

                        <span class="insignia-seguridad-acceso" title="Conexión cifrada con ASP.NET Core Identity">
                            <i class="bi bi-shield-check"></i>
                            <span>Seguro</span>
                        </span>
                    </div>

                    <!-- Botón Principal: Iniciar sesión -->
                    <button type="submit" id="btnSubmit" class="btn-enviar-acceso">
                        <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        <i class="bi bi-box-arrow-in-right fs-5" id="btnIcon"></i>
                        <span id="btnText">Iniciar sesión</span>
                    </button>
                </form>

                <footer class="pie-tarjeta-acceso">
                    <p class="derechos-acceso">&copy; @DateTime.Now.Year <strong>Say Cheese Pizza</strong> &bull; Managua, Nicaragua (C$)</p>
                </footer>
            </main>

        </div>
    </div>

    <!-- Script para Toggle de Contraseña y Estado de Envío -->
    <script>
        const btnToggle = document.getElementById('btnTogglePassword');
        const passInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('toggleIcon');

        if (btnToggle && passInput && toggleIcon) {
            btnToggle.addEventListener('click', function () {
                const isPassword = passInput.getAttribute('type') === 'password';
                passInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                btnToggle.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        }

        const loginForm = document.getElementById('loginForm');
        const btnSubmit = document.getElementById('btnSubmit');
        const btnSpinner = document.getElementById('btnSpinner');
        const btnIcon = document.getElementById('btnIcon');
        const btnText = document.getElementById('btnText');

        if (loginForm && btnSubmit) {
            loginForm.addEventListener('submit', function () {
                if (loginForm.checkValidity()) {
                    btnSubmit.setAttribute('disabled', 'disabled');
                    btnSpinner.classList.remove('d-none');
                    btnIcon.classList.add('d-none');
                    btnText.textContent = 'Verificando...';
                }
            });
        }
    </script>
</body>
</html>
