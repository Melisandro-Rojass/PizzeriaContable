@model PizzeriaContable.ViewModels.UsuarioCreateViewModel
@{
    ViewData["Title"] = "Registrar Nuevo Empleado";
    var rolesDisponibles = ViewBag.RolesDisponibles as List<string> ?? new List<string> { "Administrador", "Contabilidad", "Cajero", "Inventario", "Consulta" };
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-person-plus-fill me-2 text-warning"></i>Registrar Nuevo Empleado
            </h2>
            <p class="text-muted small mb-0">Cree una cuenta individual de acceso para un colaborador del sistema</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al listado
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4" role="alert">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Datos Personales y Laborales</h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NombreCompleto" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="NombreCompleto" class="form-control" placeholder="Ej. Roberto Morales Sánchez" required />
                                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Cargo" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="Cargo" class="form-control" placeholder="Ej. Cajero Turno Matutino, Maestro Pizzero..." />
                                <span asp-validation-for="Cargo" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-semibold small text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">@@</span>
                                    <input asp-for="UserName" class="form-control" placeholder="nombre.apellido o usuario" required autocomplete="off" />
                                </div>
                                <small class="text-muted">Nombre de usuario con el que iniciará sesión en el sistema.</small>
                                <span asp-validation-for="UserName" class="text-danger small d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="opcional@pizzeria.local" />
                                <small class="text-muted">Opcional. Para notificaciones o recuperación.</small>
                                <span asp-validation-for="Email" class="text-danger small d-block"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Permisos y Rol en el Sistema</h5>

                        <div class="mb-4">
                            <label asp-for="Rol" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="Rol" class="form-select" required>
                                <option value="Cajero">Cajero — Acceso a Punto de Venta (POS) y Turno de Caja</option>
                                <option value="Inventario">Inventario — Gestión de Ingredientes, Stock, Recetas y Compras</option>
                                <option value="Contabilidad">Contabilidad — Acceso a Cuentas T, Asientos, Libros y Reportes</option>
                                <option value="Consulta">Consulta — Visualización de reportes e información sin modificar</option>
                                <option value="Administrador">Administrador — Acceso total a empleados, roles y configuración</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Contraseña Inicial</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" required minlength="6" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repita la contraseña" required minlength="6" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary fw-semibold px-4">
                                <i class="bi bi-save me-1"></i> Guardar Empleado
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
