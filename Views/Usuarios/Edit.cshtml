@model PizzeriaContable.ViewModels.UsuarioEditViewModel
@{
    ViewData["Title"] = "Editar Empleado";
    var rolesDisponibles = ViewBag.RolesDisponibles as List<string> ?? new List<string> { "Administrador", "Contabilidad", "Cajero", "Inventario", "Consulta" };
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-pencil-square me-2 text-warning"></i>Editar Ficha de Empleado
            </h2>
            <p class="text-muted small mb-0">Modifique los datos laborales, rol de acceso y estado de la cuenta</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al listado
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4" role="alert">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Datos Personales y Laborales</h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NombreCompleto" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="NombreCompleto" class="form-control" required />
                                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Cargo" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="Cargo" class="form-control" placeholder="Ej. Cajero Turno Matutino, Maestro Pizzero..." />
                                <span asp-validation-for="Cargo" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-semibold small text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">@@</span>
                                    <input asp-for="UserName" class="form-control" required />
                                </div>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="opcional@pizzeria.local" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Permisos y Estado de la Cuenta</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Rol" class="form-label fw-semibold small text-secondary"></label>
                                <select asp-for="Rol" class="form-select" required>
                                    <option value="Cajero">Cajero — Punto de Venta (POS) y Caja</option>
                                    <option value="Inventario">Inventario — Stock, Ingredientes y Compras</option>
                                    <option value="Contabilidad">Contabilidad — Cuentas T, Asientos y Balances</option>
                                    <option value="Consulta">Consulta — Solo Lectura</option>
                                    <option value="Administrador">Administrador — Acceso Total</option>
                                </select>
                                <span asp-validation-for="Rol" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" asp-for="Activo" id="activoSwitch" />
                                    <label class="form-check-label fw-semibold" for="activoSwitch">
                                        Cuenta Habilitada (Permitir acceso)
                                    </label>
                                    <small class="text-muted d-block">Si se desmarca, se invalidarán las sesiones activas del usuario.</small>
                                </div>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Actualizar Contraseña (Opcional)</h5>

                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="Dejar vacío para mantener la contraseña actual" minlength="6" />
                            <small class="text-muted">Ingrese una nueva contraseña únicamente si desea sustituir la actual.</small>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary fw-semibold px-4">
                                <i class="bi bi-check-lg me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
