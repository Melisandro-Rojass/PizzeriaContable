@model IEnumerable<PizzeriaContable.Models.ApplicationUser>
@{
    ViewData["Title"] = "Gestión de Personal y Usuarios";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-people me-2 text-primary"></i>Personal y Roles</h2>
            <p class="text-muted small mb-0">Control de accesos y responsabilidades (Cajero, Inventario, Contador, Administrador)</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold">
            <i class="bi bi-person-plus-fill me-1"></i> Registrar Usuario
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Correo Electrónico</th>
                        <th>Rol Asignado</th>
                        <th class="text-center">Estado</th>
                        <th>Fecha de Alta</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        string badgeRol = u.Rol switch
                        {
                            "Administrador" => "bg-danger",
                            "Contador" => "bg-success",
                            "EncargadoInventario" => "bg-warning text-dark",
                            "Cajero" => "bg-primary",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="fw-bold">
                                <i class="bi bi-person-circle text-secondary me-2"></i>@u.NombreCompleto
                            </td>
                            <td>@u.Email</td>
                            <td><span class="badge @badgeRol">@u.Rol</span></td>
                            <td class="text-center">
                                @if (u.Activo)
                                {
                                    <span class="badge bg-success-subtle text-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">Inactivo</span>
                                }
                            </td>
                            <td class="small text-muted">@u.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i> Editar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
