@model PizzeriaContable.Models.ConfiguracionEmpresa
@{
    ViewData["Title"] = "Configuración de la Empresa";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-gear me-2 text-primary"></i>Configuración de la Empresa</h2>
            <p class="text-muted small mb-0">Identidad del negocio, datos fiscales para tickets y parámetros contables</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-shop me-2"></i>Identidad Comercial</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="NombreComercial" class="form-label fw-bold"></label>
                                <input asp-for="NombreComercial" class="form-control" required />
                                <span asp-validation-for="NombreComercial" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RazonSocial" class="form-label fw-bold"></label>
                                <input asp-for="RazonSocial" class="form-control" />
                                <span asp-validation-for="RazonSocial" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IdentificacionTributaria" class="form-label fw-bold"></label>
                                <input asp-for="IdentificacionTributaria" class="form-control" placeholder="Ej. J0310000012345" />
                                <span asp-validation-for="IdentificacionTributaria" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label fw-bold"></label>
                                <input asp-for="Telefono" class="form-control" placeholder="+505 2222-3344" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CorreoElectronico" class="form-label fw-bold"></label>
                                <input asp-for="CorreoElectronico" class="form-control" />
                                <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Direccion" class="form-label fw-bold"></label>
                                <input asp-for="Direccion" class="form-control" placeholder="Ciudad, Dirección física" />
                                <span asp-validation-for="Direccion" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h5 class="fw-bold text-success mb-3"><i class="bi bi-coin me-2"></i>Parámetros Fiscales y Monetarios</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="MonedaPrincipal" class="form-label fw-bold"></label>
                                <input asp-for="MonedaPrincipal" class="form-control" required />
                                <small class="text-muted">ISO 4217 (Ej. NIO)</small>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SimboloMoneda" class="form-label fw-bold"></label>
                                <input asp-for="SimboloMoneda" class="form-control" required />
                                <small class="text-muted">Símbolo (Ej. C$)</small>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TasaIvaPorcentaje" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <input asp-for="TasaIvaPorcentaje" type="number" step="0.01" class="form-control" required />
                                    <span class="input-group-text">%</span>
                                </div>
                                <small class="text-muted">Tasa IVA Nicaragua: 15%</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ZonaHoraria" class="form-label fw-bold"></label>
                                <input asp-for="ZonaHoraria" class="form-control" required />
                                <small class="text-muted">Ej. America/Managua</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaInicioContable" class="form-label fw-bold"></label>
                                <input asp-for="FechaInicioContable" type="date" class="form-control" required />
                                <small class="text-muted">Fecha inicial del ejercicio contable</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary fw-bold px-4">
                                <i class="bi bi-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
